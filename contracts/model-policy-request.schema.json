{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-policy-request/v1",
  "description": "Runtime additionally validates duplicate keys/IDs, reference consistency, safe file containment and valid UTC calendar values. Evidence hashes establish consistency, not authentic model behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role",
    "risk",
    "host",
    "policy_path",
    "observation_path",
    "project_config_path",
    "cli",
    "budget",
    "requested_effort",
    "resume_selection_path"
  ],
  "properties": {
    "schema": {
      "const": "model-policy-request/v1"
    },
    "role": {
      "type": "string",
      "enum": [
        "implementer",
        "investigator",
        "spec-reviewer-a",
        "spec-reviewer-b",
        "impl-reviewer-a",
        "impl-reviewer-b",
        "task-reviewer-a",
        "task-reviewer-b",
        "evaluator",
        "domain-reviewer-a",
        "domain-reviewer-b",
        "workflow-auditor-a",
        "workflow-auditor-b",
        "diagnosis",
        "self-improvement",
        "panelist-gpt",
        "panelist-gemini"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "host": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex-cli",
        "copilot-cli",
        "gemini-cli"
      ]
    },
    "policy_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|\\\\|(^|/)\\.{1,2}(/|$)|//|/$|[\\x00-\\x1f\\x7f])"
      }
    },
    "observation_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|\\\\|(^|/)\\.{1,2}(/|$)|//|/$|[\\x00-\\x1f\\x7f])"
      }
    },
    "project_config_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\\\|(^|/)\\.{1,2}(/|$)|//|/$|[\\x00-\\x1f\\x7f])"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "policy"
      ],
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "latest-compatible",
                "pinned"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "budget": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "unit"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "USD"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_effort": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_selection_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\\\|(^|/)\\.{1,2}(/|$)|//|/$|[\\x00-\\x1f\\x7f])"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "estimates": {
      "anyOf": [
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "catalog_id",
              "amount",
              "unit",
              "source_url",
              "source_date"
            ],
            "properties": {
              "catalog_id": {
                "$ref": "#/$defs/identifier"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "const": "USD"
              },
              "source_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:[^\\s/?#@:\\[\\]]+|\\[[^\\]\\s]+\\])(?::[0-9]*)?(?:[/?#][^\\s]*)?(?![\\s\\S])"
              },
              "source_date": {
                "$ref": "#/$defs/utc"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])",
      "format": "date-time"
    }
  }
}
