{
  "schema": "capability-registry/v1",
  "gates": [
    {
      "id": "check-update-migration",
      "stage": "implementation",
      "blocking": true,
      "implementation_ref": "plugins/sdd-quality-loop/scripts/check-update-migration.py"
    },
    {
      "id": "check-installed-plugin-drift",
      "stage": "implementation",
      "blocking": true,
      "implementation_ref": "plugins/sdd-quality-loop/scripts/check-installed-plugin-drift.py"
    },
    {
      "id": "check-a8-classification-table",
      "stage": "implementation",
      "blocking": true,
      "implementation_ref": "plugins/sdd-quality-loop/scripts/check-a8-classification-table.py"
    },
    {
      "id": "check-a8-scope-boundary",
      "stage": "implementation",
      "blocking": true,
      "implementation_ref": "plugins/sdd-quality-loop/scripts/check-a8-scope-boundary.py"
    },
    {
      "id": "check-a8-citation-compliance",
      "stage": "implementation",
      "blocking": true,
      "implementation_ref": "plugins/sdd-quality-loop/scripts/check-a8-citation-compliance.py"
    }
  ],
  "capabilities": [
    {
      "id": "durable-workflow",
      "trigger": {
        "any": [
          {
            "scope": "affected_component",
            "field": "artifact_kinds",
            "operator": "contains",
            "value": "durable_workflow"
          }
        ]
      },
      "required_facets": ["data-spec"],
      "conditional_facets": [
        {
          "facet": "pii-handling-spec",
          "when": {
            "scope": "affected_component",
            "field": "characteristics.pii",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "review_check_ids": ["durable-workflow-replay-safety"],
      "gate_ids": ["check-update-migration"],
      "lite_policy": { "eligible": false, "upgrade_reasons": ["durable_workflow"] },
      "minimum_enforcement": "required",
      "delivery_strategy": { "kind": "durable-workflow" }
    },
    {
      "id": "developer-tooling",
      "trigger": {
        "any": [
          {
            "scope": "affected_component",
            "field": "artifact_kinds",
            "operator": "contains",
            "value": "plugin_package"
          },
          {
            "scope": "affected_component",
            "field": "artifact_kinds",
            "operator": "contains",
            "value": "mcp_server"
          },
          {
            "scope": "affected_component",
            "field": "artifact_kinds",
            "operator": "contains",
            "value": "installer_script"
          }
        ]
      },
      "required_facets": [
        "developer-tooling-spec"
      ],
      "conditional_facets": [],
      "review_check_ids": [
        "developer-tooling-distribution-compatibility"
      ],
      "gate_ids": [],
      "lite_policy": {
        "eligible": true
      },
      "delivery_strategy": {
        "kind": "human-copy"
      }
    },
    {
      "id": "cli-library",
      "trigger": {
        "scope": "affected_component",
        "field": "artifact_kinds",
        "operator": "contains",
        "value": "plugin_package"
      },
      "required_facets": [
        "cli-library-spec"
      ],
      "conditional_facets": [],
      "review_check_ids": [
        "cli-library-contract-compatibility"
      ],
      "gate_ids": [],
      "lite_policy": {
        "eligible": true
      },
      "delivery_strategy": {
        "kind": "human-copy"
      }
    }
  ]
}
