{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "run_id",
    "unit_id",
    "provider",
    "scope",
    "dependency_lock",
    "policy",
    "verification_profile",
    "native_operation_id",
    "resource_ids",
    "principal",
    "completed_at",
    "collected_at",
    "classification"
  ],
  "properties": {
    "schema": {
      "const": "cloud-collection-context/v1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "provider": {
      "type": "string",
      "enum": [
        "azure",
        "aws"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "region",
        "deployment_scope"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
        },
        "region": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
        },
        "deployment_scope": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
        }
      }
    },
    "dependency_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
        }
      }
    },
    "verification_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:\\.[0-9]+){0,3}(?:-[A-Za-z0-9.-]+)?)$(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
        }
      }
    },
    "native_operation_id": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
    },
    "resource_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "principal": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
    },
    "completed_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$(?![\\s\\S])",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$(?![\\s\\S])",
      "format": "date-time"
    },
    "classification": {
      "type": "string",
      "enum": [
        "synthetic",
        "native"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
