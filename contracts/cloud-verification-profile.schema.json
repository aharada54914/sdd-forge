{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "required_check_ids",
    "max_age_seconds"
  ],
  "properties": {
    "schema": {
      "const": "cloud-verification-profile/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+){0,3}(?:-[A-Za-z0-9.-]+)?)$(?![\\s\\S])"
    },
    "required_check_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdd-forge.local/contracts/cloud-verification-profile.schema.json",
  "$comment": "Integrity only, never authority. Runtime also checks contained physical files, exact-byte digests, keyed uniqueness and cross-artifact consistency."
}
