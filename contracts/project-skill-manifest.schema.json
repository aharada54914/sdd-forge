{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdd-forge.local/contracts/project-skill-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "checks",
    "runtime",
    "entry",
    "args",
    "requires",
    "files"
  ],
  "properties": {
    "schema": {
      "enum": [
        "project-skill-manifest/v1",
        "project-skill-manifest/v2"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "runtime": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9.+-]*$"
    },
    "entry": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9=:,._+-]*$"
      },
      "minItems": 0
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "method": {
      "enum": [
        "command",
        "document"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema": {
          "const": "project-skill-manifest/v1"
        },
        "runtime": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "method"
        ]
      }
    },
    {
      "required": [
        "method"
      ],
      "properties": {
        "schema": {
          "const": "project-skill-manifest/v2"
        },
        "method": {
          "const": "command"
        },
        "runtime": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "method"
      ],
      "properties": {
        "schema": {
          "const": "project-skill-manifest/v2"
        },
        "method": {
          "const": "document"
        },
        "runtime": {
          "type": "null"
        },
        "entry": {
          "type": "null"
        },
        "args": {
          "const": []
        },
        "requires": {
          "const": []
        }
      }
    }
  ]
}
