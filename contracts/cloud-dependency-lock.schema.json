{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "upstream",
    "tools",
    "adapter_version",
    "managed_endpoints"
  ],
  "properties": {
    "schema": {
      "const": "cloud-dependency-lock/v1"
    },
    "upstream": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "commit",
          "root",
          "files"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^(?:https://[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*)$(?![\\s\\S])"
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:(?:[a-f0-9]{40}|[a-f0-9]{64}))$(?![\\s\\S])"
          },
          "root": {
            "type": "string",
            "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
            "maxLength": 1024
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "references"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
                },
                "references": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 4096,
                  "items": {
                    "type": "string",
                    "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:[0-9]+(?:\\.[0-9]+){0,3}(?:-[A-Za-z0-9.-]+)?)$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
          }
        }
      }
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+){0,3}(?:-[A-Za-z0-9.-]+)?)$(?![\\s\\S])"
    },
    "managed_endpoints": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "tool_schema"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "pattern": "^(?:https://[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*)$(?![\\s\\S])"
          },
          "tool_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdd-forge.local/contracts/cloud-dependency-lock.schema.json",
  "title": "Cloud dependency-lock v1",
  "$comment": "Integrity only, never authority. Runtime additionally checks exact-byte references, safe filesystem paths, UTC ordering/freshness, unique IDs and cross-artifact consistency. No cloud operation is authorized by schema conformance."
}
