    "binding_id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "region",
        "deployment_scope"
