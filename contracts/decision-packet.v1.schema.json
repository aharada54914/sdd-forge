{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feature",
    "task",
    "run_id",
    "objective",
    "scenario",
    "hypotheses",
    "inputs",
    "approval",
    "alternatives",
    "recommendation",
    "unknowns",
    "risks",
    "next_action",
    "previous",
    "concept_test"
  ],
  "properties": {
    "schema": {
      "const": "decision-packet/v1"
    },
    "feature": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "^T-[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "preview",
          "diff",
          "observations",
          "counterevidence",
          "unknowns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "preview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "diff": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome",
                "reason",
                "evidence",
                "measurement"
              ],
              "properties": {
                "outcome": {
                  "enum": [
                    "success",
                    "failure",
                    "timeout",
                    "cancelled",
                    "not-run",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "measurement": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "directory",
                        "span_id",
                        "run_id",
                        "records"
                      ],
                      "properties": {
                        "directory": {
                          "type": "string",
                          "minLength": 1
                        },
                        "span_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "run_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "records": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "sha256"
                            ],
                            "properties": {
                              "path": {
                                "type": "string",
                                "minLength": 1
                              },
                              "sha256": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative",
        "reason"
      ],
      "properties": {
        "alternative": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "previous": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "concept_test": {
      "type": "boolean"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
