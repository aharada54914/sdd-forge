{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdd-forge.local/contracts/project-verification-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "skill",
    "check_id",
    "skill_manifest_sha256",
    "source",
    "environment",
    "outcome"
  ],
  "properties": {
    "schema": {
      "enum": [
        "project-verification-observation/v1",
        "project-verification-observation/v2"
      ]
    },
    "mode": {
      "enum": [
        "task",
        "trial"
      ]
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "skill_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "task_input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree_sha256"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "host",
        "runtime_path",
        "missing"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux",
            "darwin",
            "windows"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "runtime_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "variables_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "sha256",
              "identity_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "identity_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "unavailable",
        "not-run"
      ]
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "exit_code": {
      "type": "integer"
    }
  }
}
