{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "unit_id",
    "provider",
    "native_operation_id",
    "resource_ids",
    "principal",
    "query",
    "timestamp",
    "exit_code",
    "status",
    "result",
    "classification"
  ],
  "properties": {
    "schema": {
      "const": "cloud-observation/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "provider": {
      "type": "string",
      "enum": [
        "azure",
        "aws"
      ]
    },
    "native_operation_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
        }
      ]
    },
    "resource_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
      }
    },
    "principal": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
    },
    "query": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$(?![\\s\\S])",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "synthetic",
        "native"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdd-forge.local/contracts/cloud-observation.schema.json",
  "title": "Cloud observation v1",
  "$comment": "Integrity only, never authority. Runtime additionally checks exact-byte references, safe filesystem paths, UTC ordering/freshness, unique IDs and cross-artifact consistency. No cloud operation is authorized by schema conformance.",
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "PASS"
        },
        "exit_code": {
          "type": "integer",
          "const": 0
        }
      }
    },
    {
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "FAIL",
            "BLOCKED",
            "UNKNOWN"
          ]
        }
      }
    }
  ]
}
