{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-forge.local/contracts/sdd-session-hub-command.v1.schema.json",
  "title": "Session hub command envelope; action payload invariants are enforced by session-hub/core.mjs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "expectedRevision",
    "action",
    "input"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "enum": [
        "register",
        "ask",
        "answer",
        "receive",
        "away",
        "enqueue",
        "claim",
        "finish",
        "cancel",
        "resolve",
        "verification"
      ]
    },
    "input": {
      "type": "object"
    }
  }
}
