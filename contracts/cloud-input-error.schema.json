{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "error_code",
    "message",
    "field"
  ],
  "properties": {
    "schema": {
      "const": "cloud-input-error/v1"
    },
    "error_code": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    },
    "message": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x7e]{1,2048})$(?![\\s\\S])"
    },
    "field": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdd-forge.local/contracts/cloud-input-error.schema.json",
  "title": "Cloud input-error v1",
  "$comment": "Integrity only, never authority. Runtime additionally checks exact-byte references, safe filesystem paths, UTC ordering/freshness, unique IDs and cross-artifact consistency. No cloud operation is authorized by schema conformance."
}
