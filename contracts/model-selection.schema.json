{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-selection/v1",
  "description": "Immutable typed selection. Runtime validates canonical digest, exact resume equality, estimate/model/amount consistency and UTC calendar; this schema does not grant access or prove source provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role",
    "risk",
    "host",
    "cli_version",
    "scope_id",
    "requested",
    "resolved",
    "policy_sha256",
    "catalog_sha256",
    "observation_sha256",
    "observed_at",
    "source_date",
    "reason",
    "update_candidates",
    "binding",
    "selection_sha256",
    "budget",
    "estimate"
  ],
  "properties": {
    "schema": {
      "const": "model-selection/v1"
    },
    "role": {
      "$ref": "#/$defs/identifier"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "host": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex-cli",
        "copilot-cli",
        "gemini-cli"
      ]
    },
    "cli_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~](?:[ -~]*[!-~])?(?![\\s\\S])"
    },
    "scope_id": {
      "$ref": "#/$defs/identifier"
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "model_id",
        "policy_source",
        "model_source"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "latest-compatible",
            "pinned"
          ]
        },
        "model_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_source": {
          "type": "string",
          "enum": [
            "cli",
            "environment",
            "project-role",
            "project-default",
            "shipped"
          ]
        },
        "model_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "cli",
                "environment",
                "project-role",
                "project-default",
                "shipped"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "native_id",
        "effort",
        "effort_control"
      ],
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/identifier"
        },
        "native_id": {
          "$ref": "#/$defs/identifier"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "effort_control": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observed_at": {
      "$ref": "#/$defs/utc"
    },
    "source_date": {
      "$ref": "#/$defs/utc"
    },
    "reason": {
      "$ref": "#/$defs/text"
    },
    "update_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "binding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "session_id",
            "attempt"
          ],
          "properties": {
            "run_id": {
              "$ref": "#/$defs/identifier"
            },
            "session_id": {
              "$ref": "#/$defs/identifier"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "budget": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "unit"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "USD"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "estimate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_id",
            "amount",
            "unit",
            "source_url",
            "source_date"
          ],
          "properties": {
            "catalog_id": {
              "$ref": "#/$defs/identifier"
            },
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "USD"
            },
            "source_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:[^\\s/?#@:\\[\\]]+|\\[[^\\]\\s]+\\])(?::[0-9]*)?(?:[/?#][^\\s]*)?(?![\\s\\S])"
            },
            "source_date": {
              "$ref": "#/$defs/utc"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requested": {
            "properties": {
              "policy": {
                "const": "pinned"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "requested": {
            "properties": {
              "model_id": {
                "$ref": "#/$defs/identifier"
              },
              "model_source": {
                "type": "string",
                "enum": [
                  "cli",
                  "environment",
                  "project-role",
                  "project-default",
                  "shipped"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "requested": {
            "properties": {
              "model_id": {
                "type": "null"
              },
              "model_source": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
