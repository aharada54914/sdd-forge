{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature Concept Test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feature",
    "proposal",
    "rationale",
    "distinctions",
    "inputs"
  ],
  "properties": {
    "schema": {
      "const": "concept-test/v1"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "proposal": {
      "enum": [
        "FITS_EXISTING_CONCEPTS",
        "NEW_CONCEPT_CANDIDATE",
        "RESPONSIBILITY_CONFLICT",
        "REQUIRES_HUMAN_DECISION"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "distinctions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concepts",
          "judgment",
          "confirmed"
        ],
        "properties": {
          "concepts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "judgment": {
            "enum": [
              "same",
              "different",
              "undecided"
            ]
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "decision": {
      "enum": [
        "proceed",
        "defer-to-domain-update",
        "rejected"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
