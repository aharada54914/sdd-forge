{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDD Concept Test evidence (feature-local)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "feature", "proposal", "rationale", "relation", "decision", "inputs"],
  "properties": {
    "schema": { "const": "sdd-concept-test/v1" },
    "feature": { "type": "string", "minLength": 1 },
    "proposal": {
      "enum": [
        "FITS_EXISTING_CONCEPTS",
        "NEW_CONCEPT_CANDIDATE",
        "RESPONSIBILITY_CONFLICT",
        "REQUIRES_HUMAN_DECISION"
      ]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "relation": { "enum": ["same", "different", "undecided"] },
    "decision": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["proceed", "defer-to-domain-update", "rejected"] }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/input" }
    }
  },
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
