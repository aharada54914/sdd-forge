{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_sha256",
    "check_id",
    "status",
    "reason",
    "sampled_at",
    "queries"
  ],
  "properties": {
    "schema": {
      "const": "cloud-check-result/v1"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
    },
    "check_id": {
      "type": "string",
      "enum": [
        "resource",
        "network",
        "identity",
        "monitoring",
        "workload",
        "backup"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "UNHEALTHY",
        "NATIVE_UNAVAILABLE",
        "MISSING_CONFIGURATION",
        "UNSUPPORTED_CONTEXT",
        "STALE_SIGNAL"
      ]
    },
    "sampled_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$(?![\\s\\S])",
      "format": "date-time"
    },
    "queries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "request_sha256",
          "response_sha256",
          "http_status"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "pattern": "^https://[^@\\\\\\r\\n ]+$"
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
          },
          "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
