{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "feature",
    "task",
    "run_id",
    "packet_sha256",
    "alternative",
    "choice",
    "reason",
    "valid_until",
    "previous"
  ],
  "properties": {
    "schema": {
      "const": "decision-choice/v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,63}$"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "alternative": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
    },
    "choice": {
      "enum": [
        "adopt",
        "reject",
        "hold"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "previous": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record",
            "approval"
          ],
          "properties": {
            "record": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
