{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "run_id",
    "api_head_sha",
    "collected_at",
    "api_version",
    "run",
    "jobs",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "verification-ci-observations/v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "api_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
    },
    "api_version": {
      "const": "2026-03-10"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:\\\\|[\\u0000-\\u001f\\u007f]))(?!.*(?:^|/)(?:\\.{1,2}|)(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:\\\\|[\\u0000-\\u001f\\u007f]))(?!.*(?:^|/)(?:\\.{1,2}|)(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "job_id",
          "source_attempt"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:\\\\|[\\u0000-\\u001f\\u007f]))(?!.*(?:^|/)(?:\\.{1,2}|)(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "job_id": {
            "type": "integer",
            "minimum": 1
          },
          "source_attempt": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "event_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "repository",
        "head_repository",
        "repository_id",
        "head_repository_id",
        "run_attempt",
        "pr_number",
        "run_id",
        "base_sha",
        "head_sha",
        "tested_sha"
      ],
      "properties": {
        "event": {
          "const": "pull_request"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "head_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "head_repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
