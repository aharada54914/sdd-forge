{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-forge.dev/contracts/session-model-selection.schema.json",
  "title": "Private project preferences and confirmed session model selection",
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model",
        "effort"
      ],
      "properties": {
        "host": {
          "enum": [
            "claude-code",
            "codex-cli",
            "gemini-cli"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "effort": {
          "enum": [
            null,
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disabled"
      ],
      "properties": {
        "disabled": {
          "const": true
        }
      }
    }
  },
  "oneOf": [
