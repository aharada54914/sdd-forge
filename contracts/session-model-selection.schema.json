                        "unverified",
                        "unavailable"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "host",
                  "model",
                  "efforts",
                  "source",
                  "verification",
                  "selectable"
                ],
                "properties": {
                  "host": {
                    "enum": [
                      "claude-code",
                      "codex-cli",
                      "gemini-cli"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "efforts": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    }
                  },
                  "source": {
                    "type": "string"
                  },
                  "verification": {
                    "enum": [
                      "listed",
                      "unverified"
                    ]
                  },
                  "selectable": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "main": {
          "oneOf": [
            {
              "type": "null"
