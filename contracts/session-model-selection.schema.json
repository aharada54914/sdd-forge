                "claude-code",
                "codex-cli",
                "gemini-cli"
              ],
              "properties": {
                "claude-code": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "installed",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "installed": {
                      "type": "boolean"
                    },
                    "status": {
                      "enum": [
                        "listed",
                        "unverified",
                        "unavailable"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                },
                "codex-cli": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "installed",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "installed": {
                      "type": "boolean"
                    },
                    "status": {
                      "enum": [
                        "listed",
                        "unverified",
                        "unavailable"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                },
