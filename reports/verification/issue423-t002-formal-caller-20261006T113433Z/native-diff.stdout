         }
         if ($input.path -cmatch '^reports/(spec|impl|task)-review/.*/reviewer-[^/]*\.json$' -or
             $input.path -cmatch '(^|/)reviewer-[ab]\.json$' -or
@@ -964,6 +1057,22 @@ try {
