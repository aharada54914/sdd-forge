+# Lexical prerequisite only: held-parent acquisition must still establish
+# no-follow/exact-name identity. Never infer that from this string check.
+admission_root_syntax_is_safe() {
+  local raw=$1 tail
+  case "$raw" in
+    [A-Za-z]:[\\/]*) tail=${raw:3}; tail=${tail//\\//} ;;
+    \\\\*)
+      tail=${raw:2}; tail=${tail//\\//}
+      # UNC needs both server and share. Device namespaces are not roots.
+      [[ "$tail" == */* && "$tail" != \?/* && "$tail" != ./* ]] || return 1 ;;
+    /*) tail=${raw:1} ;;
+    *) return 1 ;;
+  esac
+  [[ "$tail" != /* && "$tail" != */ && "$tail" != *//* ]] || return 1
+  case "/$tail/" in
+    */./*|*/../*) return 1 ;;
+  esac
+  return 0
+}
