+# One private lifetime owns the bytes used for hash, presence and binding.
+# Returns the verified array; a failed command cannot publish partial authority.
+verify_adr_precheck_binding() (
+  [[ "$stage:$role" == impl:impl-reviewer-a ||
+     "$stage:$role" == impl:impl-reviewer-b ]] || return 1
+  local pc_rel=$1 pc_hash=$2 pc_abs actual design_rel design_hash declared
+  local snapshot_dir extension
+  local adr_set declared_set invocation_set rows adr_path adr_hash
+  command -v iconv >/dev/null 2>&1 || return 1
+  umask 077
+  snapshot_dir=$(mktemp -d "${TMPDIR:-/tmp}/sdd-adr-admission.XXXXXX") || return 1
+  trap 'status=$?; rm -f -- "$snapshot_dir/precheck.json" "$snapshot_dir/design.md" "$snapshot_dir/adr.md" || status=1;
+    rmdir -- "$snapshot_dir" || status=1; exit "$status"' EXIT
+  trap 'exit 129' HUP
+  trap 'exit 130' INT
+  trap 'exit 143' TERM
+  pc_abs="$snapshot_dir/precheck.json"
+  adr_read_bound_file "$pc_rel" > "$pc_abs" || return 1
+  actual=$(sha256_file "$pc_abs") || return 1
+  [[ "$actual" == "$pc_hash" ]] || return 1
+  iconv -f UTF-8 -t UTF-8 "$pc_abs" >/dev/null 2>&1 || return 1
+  admission_adr_json_members "$pc_abs" || return 1
+  extension=$(jq -ers 'if length == 1 and (.[0] | type == "object") then
+    .[0] | if has("adr_inputs") then "present" else "absent" end
+    else error("precheck must contain exactly one object") end' "$pc_abs") || return 1
+  if [[ "$extension" == absent ]]; then printf '[]\n'; return 0; fi
+  jq -e --arg p "$pc_rel" --arg h "$pc_hash" '[.allowed_input_manifest[] |
+    select(.path | test("^reports/impl-review/[^/]+/attempt-[1-9][0-9]*/round-[1-9][0-9]*/precheck-result[.]json$"))] |
+    length == 1 and .[0].path == $p and .[0].sha256 == $h' "$manifest" >/dev/null || return 1
+  # Validate primitive types before interpolation, sorting or set comparison.
+  jq -e --arg f "$feature" --arg p "$pc_rel" '
+    type == "object" and .schema == "impl-review-precheck/v1" and
+    .feature == $f and
+    (.attempt | type == "number" and . >= 1 and . == floor) and
+    (.round | type == "number" and . >= 1 and . == floor) and
+    ($p == ("reports/impl-review/" + $f + "/attempt-" +
+      (.attempt | tostring) + "/round-" + (.round | tostring) + "/precheck-result.json")) and
+    (.design_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
+    (.adr_inputs | type == "array" and all(.[];
+      type == "object" and keys == ["path", "sha256"] and
+      (.path | type == "string" and test("^docs/adr/[0-9]{4}-[a-z0-9][a-z0-9-]*[.]md$")) and
+      (.sha256 | type == "string" and test("^[0-9a-f]{64}$")))) and
+    ([.adr_inputs[].path] == ([.adr_inputs[].path] | sort | unique))
+  ' "$pc_abs" >/dev/null || return 1
+  design_rel="specs/$feature/design.md"
+  design_hash=$(jq -er '.design_sha256' "$pc_abs") || return 1
+  jq -e --arg p "$design_rel" --arg h "$design_hash" '
+    [.allowed_input_manifest[] | select(.path == $p)] |
+    length == 1 and .[0].sha256 == $h
+  ' "$manifest" >/dev/null || return 1
+  adr_read_bound_file "$design_rel" > "$snapshot_dir/design.md" || return 1
+  actual=$(sha256_file "$snapshot_dir/design.md") || return 1
+  [[ "$actual" == "$design_hash" ]] || return 1
+  iconv -f UTF-8 -t UTF-8 "$snapshot_dir/design.md" >/dev/null 2>&1 || return 1
+  declared=$(adr_declared_paths "$snapshot_dir/design.md") || return 1
+  declared_set=$(printf '%s' "$declared" | jq -Rsc 'split("\n") | map(select(length > 0))') || return 1
+  adr_set=$(jq -cS '.adr_inputs' "$pc_abs") || return 1
+  jq -e --argjson wanted "$declared_set" '[.adr_inputs[].path] == $wanted' \
+    "$pc_abs" >/dev/null || return 1
+  invocation_set=$(jq -cS '[.allowed_input_manifest[] |
+    select(.path | startswith("docs/adr/"))] | sort_by(.path)' "$manifest") || return 1
+  [[ "$invocation_set" == "$adr_set" ]] || return 1
+  rows=$(jq -r '.[] | [.path, .sha256] | @tsv' <<< "$adr_set") || return 1
+  if [[ -n "$rows" ]]; then
+    while IFS=$'\t' read -r adr_path adr_hash; do
+      adr_read_bound_file "$adr_path" > "$snapshot_dir/adr.md" || return 1
+      actual=$(sha256_file "$snapshot_dir/adr.md") || return 1
+      [[ "$actual" == "$adr_hash" ]] || return 1
+    done <<< "$rows"
+  fi
+  printf '%s\n' "$adr_set"
+)
