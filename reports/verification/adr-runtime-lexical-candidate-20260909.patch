+# Extension-only; return no authority until every binding has been checked.
+function Get-VerifiedAdrPrecheckBinding {
+    param($Invocation, [string]$Root, [string]$Feature, [string]$Stage, [string]$Role,
+        $PrecheckSnapshot, $Precheck)
+    if ($Stage -cne 'impl' -or $Role -cnotin @('impl-reviewer-a', 'impl-reviewer-b')) {
+        throw 'ADR extension is restricted to implementation reviewers'
+    }
+    $entries = @($Invocation.allowed_input_manifest | Where-Object {
+        $_.path -cmatch '^reports/impl-review/[^/]+/attempt-[1-9][0-9]*/round-[1-9][0-9]*/precheck-result[.]json$'
+    })
+    if ($entries.Count -ne 1) { throw 'ADR binding requires exactly one precheck' }
+    $entry = $entries[0]
+    $pcPath = Join-Path $Root $entry.path
+    if ($PrecheckSnapshot.Path -cne $pcPath -or $PrecheckSnapshot.Sha256 -cne $entry.sha256) {
+        throw 'ADR precheck hash mismatch'
+    }
+    # The caller supplies the object parsed from this exact checked snapshot.
+    $pc = $Precheck
+    if ($pc -isnot [Collections.IDictionary]) { throw 'ADR precheck must be an object' }
+    foreach ($key in @('schema', 'feature', 'attempt', 'round', 'design_sha256', 'adr_inputs')) {
+        if ($pc.Keys -cnotcontains $key) { throw "Missing exact precheck field: $key" }
+    }
+    if ($pc.schema -isnot [string] -or $pc.feature -isnot [string] -or
+        $pc.schema -cne 'impl-review-precheck/v1' -or $pc.feature -cne $Feature -or
+        -not (Test-JsonInteger $pc.attempt) -or $pc.attempt -lt 1 -or
+        -not (Test-JsonInteger $pc.round) -or $pc.round -lt 1) {
+        throw 'Invalid ADR precheck identity'
+    }
+    $expectedPc = "reports/impl-review/$Feature/attempt-$($pc.attempt)/round-$($pc.round)/precheck-result.json"
+    if ($entry.path -cne $expectedPc -or $pc.design_sha256 -isnot [string] -or
+        $pc.design_sha256 -cnotmatch '^[0-9a-f]{64}$' -or $pc.adr_inputs -isnot [array]) {
+        throw 'Invalid ADR precheck path, design hash or array'
+    }
+    $verified = [Collections.Generic.Dictionary[string,string]]::new([StringComparer]::Ordinal)
+    $previous = $null
+    foreach ($adr in $pc.adr_inputs) {
+        if ($adr -isnot [Collections.IDictionary] -or
+            -not (Test-ExactKeys $adr @('path', 'sha256')) -or
+            $adr.path -isnot [string] -or $adr.sha256 -isnot [string] -or
+            $adr.path -cnotmatch '^docs/adr/[0-9]{4}-[a-z0-9][a-z0-9-]*[.]md$' -or
+            $adr.sha256 -cnotmatch '^[0-9a-f]{64}$') {
+            throw 'Malformed ADR binding'
+        }
+        if ($null -ne $previous -and [string]::CompareOrdinal($previous, $adr.path) -ge 0) {
+            throw 'ADR bindings must be unique and ordinal sorted'
+        }
+        $verified.Add($adr.path, $adr.sha256)
+        $previous = $adr.path
+    }
+    $designRel = "specs/$Feature/design.md"
+    $designEntries = @($Invocation.allowed_input_manifest | Where-Object { $_.path -ceq $designRel })
+    if ($designEntries.Count -ne 1 -or $designEntries[0].sha256 -cne $pc.design_sha256 -or
+        -not (Test-AdrBoundFilePath $Root $designRel)) { throw 'Missing or unsafe bound design' }
+    $designPath = Join-Path $Root $designRel
+    $designSnapshot = Read-AdrAdmissionSnapshot $designPath
+    if ($designSnapshot.Sha256 -cne $pc.design_sha256) {
+        throw 'ADR design hash mismatch'
+    }
+    $declared = @(Get-AdrDeclaredPaths $designSnapshot.Bytes)
+    if ($declared.Count -ne $verified.Count) { throw 'ADR declaration set mismatch' }
+    foreach ($path in $declared) {
+        if (-not $verified.ContainsKey($path)) { throw 'Undeclared ADR binding' }
+    }
+    $invocationAdrs = @($Invocation.allowed_input_manifest | Where-Object {
+        $_.path.StartsWith('docs/adr/', [StringComparison]::Ordinal)
+    })
+    if ($invocationAdrs.Count -ne $verified.Count) { throw 'Invocation ADR set mismatch' }
+    $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
+    foreach ($adr in $invocationAdrs) {
+        if (-not $seen.Add($adr.path) -or -not $verified.ContainsKey($adr.path) -or
+            $verified[$adr.path] -cne $adr.sha256) { throw 'Invocation ADR binding mismatch' }
+        if (-not (Test-AdrBoundFilePath $Root $adr.path)) { throw 'Unsafe ADR file path' }
+        if ((Get-FileHash -LiteralPath (Join-Path $Root $adr.path) -Algorithm SHA256).Hash.ToLowerInvariant() -cne $adr.sha256) {
+            throw 'ADR file hash mismatch'
+        }
+    }
+    return ,$pc.adr_inputs
+}
