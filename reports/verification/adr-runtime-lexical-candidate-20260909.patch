+# This is a lexical prerequisite, not the held-handle acquisition guarantee.
+function Assert-AdrRepositoryRootSyntax([string]$RawRoot) {
+    $tail = $null
+    if ($IsWindows) {
+        if ($RawRoot -cmatch '^[A-Za-z]:[\\/]') {
+            $tail = $RawRoot.Substring(3).Replace('\', '/')
+        }
+        elseif ($RawRoot.StartsWith('\\', [StringComparison]::Ordinal)) {
+            $tail = $RawRoot.Substring(2).Replace('\', '/')
+            if (-not $tail.Contains('/') -or $tail.StartsWith('?/', [StringComparison]::Ordinal) -or
+                $tail.StartsWith('./', [StringComparison]::Ordinal)) {
+                throw 'Invalid repository share root syntax'
+            }
+        }
+    }
+    elseif ($RawRoot.StartsWith('/', [StringComparison]::Ordinal)) {
+        $tail = $RawRoot.Substring(1)
+    }
+    if ($null -eq $tail -or $tail.StartsWith('/', [StringComparison]::Ordinal) -or
+        $tail.EndsWith('/', [StringComparison]::Ordinal) -or $tail.Contains('//') -or
+        ('/' + $tail + '/') -cmatch '/[.]{1,2}/') {
+        throw 'Implementation review requires an unambiguous absolute repository root'
+    }
+}
