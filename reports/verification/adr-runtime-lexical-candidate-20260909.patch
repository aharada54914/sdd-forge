+# POSIX acquisition backend. No pathname check followed by an independent read.
+# This backend deliberately has no weaker fallback when dir-fd support is absent.
+adr_read_bound_file() {
+  is_canonical_path "$1" || return 1
+  command -v python3 >/dev/null 2>&1 || return 1
+  python3 -I - "$admission_raw_repository_root" "$1" <<'PY'
+import os
+import stat
+import sys
+
+def darwin_mount(fd):
+    # STATFS64 layout from Darwin sys/mount.h; no pathname lookup is used.
+    # This metadata classifies a crossing, but does not authorize one.
+    import ctypes
+    if sys.platform != 'darwin' or ctypes.sizeof(ctypes.c_void_p) != 8:
+        raise ValueError('unsupported Darwin ABI')
+    class Statfs64(ctypes.Structure):
+        _fields_ = [
+            ('bsize', ctypes.c_uint32), ('iosize', ctypes.c_int32),
+            ('blocks', ctypes.c_uint64), ('bfree', ctypes.c_uint64),
+            ('bavail', ctypes.c_uint64), ('files', ctypes.c_uint64),
+            ('ffree', ctypes.c_uint64), ('fsid', ctypes.c_int32 * 2),
+            ('owner', ctypes.c_uint32), ('type', ctypes.c_uint32),
+            ('flags', ctypes.c_uint32), ('subtype', ctypes.c_uint32),
+            ('typename', ctypes.c_char * 16),
+            ('mounted_on', ctypes.c_char * 1024),
+            ('mounted_from', ctypes.c_char * 1024),
+            ('extended_flags', ctypes.c_uint32),
+            ('reserved', ctypes.c_uint32 * 7),
+        ]
+    if (ctypes.sizeof(Statfs64) != 2168 or
+            Statfs64.fsid.offset != 48 or
+            Statfs64.extended_flags.offset != 2136):
+        raise ValueError('Darwin statfs ABI mismatch')
+    library = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)
+    query = library.fstatfs64
+    query.argtypes = [ctypes.c_int, ctypes.POINTER(Statfs64)]
+    query.restype = ctypes.c_int
+    result = Statfs64()
+    ctypes.set_errno(0)
+    if query(fd, ctypes.byref(result)) != 0:
+        raise OSError(ctypes.get_errno(), 'descriptor mount query failed')
+    raw_type = bytes(result.typename)
+    if not raw_type or len(raw_type) == 16:
+        raise ValueError('invalid filesystem type')
+    return {
+        'fsid': tuple(result.fsid),
+        'type': raw_type.decode('ascii', errors='strict'),
+        'owner': int(result.owner),
+        'flags': int(result.flags),
+        'extended_flags': int(result.extended_flags),
+    }
+
+def darwin_root_data_mounts(root_fd, data_fd):
+    # Identification prerequisite ONLY. Association, mapping and ACL stability
+    # must be established separately before permitting a crossing.
+    # Darwin sys/mount.h MNT_VISFLAGMASK; command/unknown flags are not states.
+    visible_flags = 0xdff0f7ff
+    readonly, local, rootfs = 0x1, 0x1000, 0x4000
+    union, ignore_ownership = 0x20, 0x00200000
+    root_data_volume = 0x1
+    root_mount, data_mount = darwin_mount(root_fd), darwin_mount(data_fd)
+    for mount in (root_mount, data_mount):
+        if (mount['type'] != 'apfs' or mount['owner'] != 0 or
+                not (mount['flags'] & local) or
+                mount['flags'] & ~visible_flags or
+                mount['flags'] & (union | ignore_ownership) or
+                mount['fsid'] == (0, 0)):
+            raise ValueError('unsupported root/Data filesystem')
+    if (root_mount['flags'] & (readonly | rootfs) != (readonly | rootfs) or
+            root_mount['extended_flags'] != 0):
+        raise ValueError('unidentified read-only root filesystem')
+    if (data_mount['flags'] & rootfs or
+            data_mount['extended_flags'] != root_data_volume or
+            data_mount['fsid'] == root_mount['fsid']):
+        raise ValueError('unidentified root Data filesystem')
+    # Equality to ROOT_DATA_VOL also rejects FSKIT and unknown extended flags.
+    # Do not hardcode host fsids or use mounted_on/mounted_from pathname text.
+    return root_mount, data_mount
+
+def read_bound(root, relative):
+    if os.name != 'posix':
+        raise ValueError('unsupported backend')
+    if not root.startswith('/') or root.startswith('//'):
+        raise ValueError('invalid root')
+    roots = [] if root == '/' else root[1:].split('/')
+    parts = roots + relative.split('/')
+    if any(part in ('', '.', '..') or '\\' in part for part in parts):
+        raise ValueError('invalid component')
+    if (os.open not in os.supports_dir_fd or
+            os.scandir not in os.supports_fd):
+        raise ValueError('unavailable capability')
+    # Attribute absence is a rejection; zero-valued fallback flags are unsafe.
+    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
+    directory_flags = flags | os.O_DIRECTORY
+    held = []
+    try:
+        held.append(os.open('/', directory_flags))
+        for index, name in enumerate(parts):
+            parent = held[-1]
+            directory = index < len(parts) - 1
+            child = os.open(name, directory_flags if directory else flags,
+                            dir_fd=parent)
+            held.append(child)
+            opened = os.fstat(child)
+            expected_type = stat.S_ISDIR if directory else stat.S_ISREG
+            if not expected_type(opened.st_mode):
+                raise ValueError('invalid object type')
+            # One dirent supplies BOTH name and inode; a later pathname stat
+            # could instead observe a restored wrong-case object (ABA).
+            entry_inode = None
+            with os.scandir(parent) as entries:
+                for entry in entries:
+                    if entry.name == name:
+                        entry_inode = entry.inode()
+                        break
+            if entry_inode is None:
+                raise ValueError('entry spelling mismatch')
+            if (os.fstat(parent).st_dev != opened.st_dev or
+                    entry_inode != opened.st_ino):
+                if sys.platform == 'darwin':
+                    parent_mount = darwin_mount(parent)
+                    child_mount = darwin_mount(child)
+                    if parent_mount['fsid'] != child_mount['fsid']:
+                        # The held slash anchor, not an arbitrary parent, must
+                        # identify the read-only root. This still does not bind
+                        # a logical source entry to its physical destination.
+                        darwin_root_data_mounts(held[0], child)
+                        # Classification only; no return/continue authorizes it.
+                        raise ValueError('Darwin mount crossing requires binding')
+                # INCOMPLETE: mount/firmlink mapping requires a native backend.
+                # Do not publish this staged reader as full transport support
+                # or fall back to the old split name/stat check.
+                raise ValueError('entry binding unavailable')
+        chunks = []
+        while True:
+            chunk = os.read(held[-1], 65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        return b''.join(chunks)
+    finally:
+        # Attempt every close even if an individual close fails.
+        close_failed = False
+        for descriptor in reversed(held):
+            try:
+                os.close(descriptor)
+            except OSError:
+                close_failed = True
+        if close_failed:
+            raise OSError('close failed')
+
+try:
+    content = read_bound(sys.argv[1], sys.argv[2])
+    sys.stdout.buffer.write(content)
+    sys.stdout.buffer.flush()
+except Exception:
+    sys.stderr.write('ADR input acquisition failed\n')
+    sys.exit(1)
+PY
+}
+
+# RT-20260908-004: restricted line grammar; not a general Markdown parser.
+adr_declared_paths() {
+  local design_file=$1
+  LC_ALL=C awk '
+    function width(s, i, ch, n) {
+      n = 0
+      while (substr(s, i + n, 1) == ch) n++
+      return n
+    }
+    function escaped(s, i, n) {
+      n = 0
+      while (i > 1 && substr(s, i - 1, 1) == "\\") { n++; i-- }
+      return n % 2
+    }
+    {
+      line = $0
+      sub(/\r$/, "", line)
+      match(line, /^ */)
+      indent = RLENGTH
+      rest = substr(line, indent + 1)
+      ch = substr(rest, 1, 1)
+      if (fence != "") {
+        if (indent <= 3 && ch == fence) {
+          n = width(rest, 1, ch)
+          if (n >= fence_width && substr(rest, n + 1) ~ /^[ \t]*$/) fence = ""
+        }
+        next
+      }
+      if (indent >= 4 || rest ~ /^\t/) next
+      if (ch == "\140" || ch == "~") {
+        n = width(rest, 1, ch)
+        if (n >= 3) { fence = ch; fence_width = n; next }
+      }
+      i = 1
+      while (i <= length(line)) {
+        if (substr(line, i, 1) != "\140") { i++; continue }
+        n = width(line, i, "\140")
+        if (escaped(line, i)) { i += n; continue }
+        j = i + n
+        closed = 0
+        while (j <= length(line)) {
+          if (substr(line, j, 1) != "\140") { j++; continue }
+          m = width(line, j, "\140")
+          if (!escaped(line, j) && m == n) { closed = 1; break }
+          j += m
+        }
+        if (!closed) break
+        value = substr(line, i + n, j - i - n)
+        if (n == 1 && value ~ /^docs\/adr\/[0-9][0-9][0-9][0-9]-[a-z0-9][a-z0-9-]*[.]md$/)
+          print value
+        i = j + n
+      }
+    }
+  ' "$design_file" | LC_ALL=C sort -u
+}
