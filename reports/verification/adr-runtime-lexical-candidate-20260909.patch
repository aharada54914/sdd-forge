+# Hash and interpret one read, never a hash-then-reopen pair. The caller must
+# check path safety first; this reader does not establish atomic no-follow.
+function Read-AdrAdmissionSnapshot([string]$Path) {
+    $bytes = [IO.File]::ReadAllBytes($Path)
+    $decoder = [Text.UTF8Encoding]::new($false, $true)
+    $text = $decoder.GetString($bytes)
+    $hasher = [Security.Cryptography.SHA256]::Create()
+    try {
+        $digest = [BitConverter]::ToString($hasher.ComputeHash($bytes)).Replace('-', '').ToLowerInvariant()
+    } finally {
+        $hasher.Dispose()
+    }
+    return [pscustomobject]@{ Path=$Path; Sha256=$digest; Text=$text; Bytes=$bytes }
+}
