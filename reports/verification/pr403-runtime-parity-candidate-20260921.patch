diff --git a/tests/scripts.tests.ps1 b/tests/scripts.tests.ps1
--- a/tests/scripts.tests.ps1
+++ b/tests/scripts.tests.ps1
@@ -2351,6 +2351,18 @@
         throw "T-007a.7: should fail with dirty tree. Got exit $t007a_check_7_exit"
     }
     Write-Host "ok: T-007a.7: critical with dirty tree fails"
+
+    # T-007a.7b: reject a non-boolean dirty marker before signature verification.
+    $t007a_bundle_json = Get-Content -Raw -Encoding Utf8 $t007a_critical_bundle | ConvertFrom-Json
+    $t007a_bundle_json.git_generated_dirty = "false"
+    $t007a_bundle_json | ConvertTo-Json -Depth 6 | Set-Content -Encoding Utf8 $t007a_critical_bundle
+    $t007a_check_7b_output = & pwsh -NoProfile -ExecutionPolicy Bypass -File (Join-Path $scriptsDir "check-evidence-bundle.ps1") $t007a_critical_bundle -RepoRoot "$t007aRepo" 2>&1
+    $t007a_check_7b_exit = $LASTEXITCODE
+    $t007a_check_7b_str = ($t007a_check_7b_output | Out-String)
+    if ($t007a_check_7b_exit -eq 0 -or $t007a_check_7b_str -notmatch "git_generated_dirty must be a JSON boolean") {
+        throw "T-007a.7b: non-boolean dirty marker should fail closed. Got exit $t007a_check_7b_exit. Output: $t007a_check_7b_str"
+    }
+    Write-Host "ok: T-007a.7b: non-boolean dirty marker fails closed"
 
     # Restore bundle
     $t007a_regen_exit = Invoke-Gate "generate-evidence-bundle.ps1" @("-ContractPath", "$t007aRepo/specs/test-feature/verification/T-200.contract.json", "-QualityReport", "$t007aRepo/reports/quality-gate/T-200.md", "-RepoRoot", "$t007aRepo")
