diff --git a/plugins/sdd-quality-loop/scripts/check-workflow-state.ps1 b/plugins/sdd-quality-loop/scripts/check-workflow-state.ps1
--- a/plugins/sdd-quality-loop/scripts/check-workflow-state.ps1
