{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskBoardFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
