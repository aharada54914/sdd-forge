+   echo "$t007a_4c_out" | grep -q "non-empty alg and value"; then
+    ok "T-007a.4c: empty signature alg fails"
+else
+    fail "T-007a.4c: empty signature alg should fail. Got: $t007a_4c_out"
+fi
 
