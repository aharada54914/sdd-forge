+parity_check "wfi022: approval-removing sed allowed" 0 \
+    "{\"tool_name\":\"bash\",\"tool_input\":{\"command\":\"sed -i '' 's/^${WFI_APPROVAL_MARKER}$/${WFI_APPLIED_MARKER}/' docs/workflow-improvements/WFI-001.md\"}}"
+
+# Reproduced false positive 4: creating prose that quotes the field (allow).
+parity_check "wfi022: Write of WFI prose mention allowed" 0 \
