+# ---------------------------------------------------------------------------
+# WFI-022: WFI approval matching is column-0/full-line precise, Edit and
+# edits[] compare net counts, and shell read-only detection reuses the guard's
+# generated write/redirect invariants. Assemble the protected marker at runtime
+# so this detection suite is not its own false-positive fixture (WFI-012).
 # ---------------------------------------------------------------------------
+WFI_STATUS_FIELD='Status:'
+WFI_APPROVED_VALUE=' Approved'
+WFI_APPROVAL_MARKER="${WFI_STATUS_FIELD}${WFI_APPROVED_VALUE}"
+WFI_APPLIED_MARKER="${WFI_STATUS_FIELD} Applied"
+WFI_QUOTED_PROSE="The guard rejects \`${WFI_APPROVAL_MARKER}\` when it is a field."
+
+# Reproduced false positive 1: an Edit adds only a prose mention (allow).
+parity_check "wfi022: prose-quoting Edit allowed" 0 \
+    "{\"tool_name\":\"edit\",\"tool_input\":{\"file_path\":\"${WFI_FILE}\",\"old_string\":\"## Result\\nPending.\",\"new_string\":\"## Result\\n${WFI_QUOTED_PROSE}\"}}"
+
+# edits[] uses the same net-count rule: removing a field is allowed.
+parity_check "wfi022: edits list net removal allowed" 0 \
+    "{\"tool_name\":\"multiedit\",\"tool_input\":{\"file_path\":\"${WFI_FILE}\",\"edits\":[{\"old_string\":\"${WFI_APPROVAL_MARKER}\",\"new_string\":\"${WFI_APPLIED_MARKER}\"}]}}"
+
+# Reproduced false positive 2: grep is read-only and has no redirect (allow).
+parity_check "wfi022: read-only grep allowed" 0 \
+    "{\"tool_name\":\"bash\",\"tool_input\":{\"command\":\"grep -H '${WFI_APPROVAL_MARKER}' docs/workflow-improvements/WFI-001.md docs/workflow-improvements/WFI-002.md\"}}"
+
+# Reproduced false positive 3: the removal command's marker is not a field
