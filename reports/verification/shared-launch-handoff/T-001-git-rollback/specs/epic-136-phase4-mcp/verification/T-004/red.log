/**
 * RED proof (b), captured WITHOUT modifying any tracked file.
 *
 * Calls the compiled `evidenceFindMissing` directly against the same
 * scan-failure fixture shape TEST-007 uses, and prints its raw response, to
 * show that at this commit the `undeterminable` field does not exist at all
 * (so TEST-007's and the parity assertion's expectations cannot hold).
 */
import { mkdtempSync, mkdirSync, writeFileSync, realpathSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { createHash } from "node:crypto";

const BASE = "/Users/jrmag/Projects/active/sdd-forge-wt-phase4/mcp/sdd-forge-mcp";
const { evidenceFindMissing } = await import(`${BASE}/dist-test/src/tools/evidence.js`);
const { parseTaskState } = await import(`${BASE}/dist-test/src/parsers/tasks.js`);

const sha256 = (s) => createHash("sha256").update(s, "utf-8").digest("hex");
const write = (dir, rel, contents) => {
  const full = join(dir, rel);
  mkdirSync(join(full, ".."), { recursive: true });
  writeFileSync(full, contents, "utf-8");
};

const dir = mkdtempSync(join(tmpdir(), "t004-red-probe-"));
mkdirSync(join(dir, "specs"), { recursive: true });
mkdirSync(join(dir, "reports"), { recursive: true });
writeFileSync(join(dir, "AGENTS.md"), "# AGENTS\n", "utf-8");
const root = Object.freeze({ path: realpathSync(dir), source: "cwd" });

write(
  dir,
  "specs/demo/tasks.md",
  [
    "# Tasks: demo",
    "",
    "Task-Review-Status: Passed",
    "",
    "## T-001",
    "",
    "Approval: Approved (alice 2026-01-01T00:00:00Z)",
    "Status: Done",
    "Risk: low",
    "",
  ].join("\n"),
);
const investigation = "# Investigation: demo\n\nBody.\n";
write(dir, "specs/demo/investigation.md", investigation);
const contract = JSON.stringify({
  task_id: "T-001",
  feature: "demo",
  risk: "low",
  required_workflow: "tdd",
  checks: [{ id: "unit-tests", required: true, passes: true, evidence: "specs/demo/investigation.md" }],
});
write(dir, "specs/demo/verification/T-001.contract.json", contract);
const qgReport = ["# Quality Gate - T-001", "", "Task ID: T-001", "", "VERDICT: PASS", ""].join("\n");
write(
  dir,
  "specs/demo/verification/T-001.evidence.json",
  JSON.stringify({
    task_id: "T-001",
    feature: "demo",
    risk: "low",
    required_workflow: "tdd",
    quality_report: "reports/quality-gate/demo-T-001.md",
    verification_contract: "specs/demo/verification/T-001.contract.json",
    git_commit: "a".repeat(40),
    git_generated_dirty: false,
    artifacts: [{ path: "specs/demo/investigation.md", sha256: sha256(investigation) }],
  }),
);

// The TEST-007 scan-failure shape: reports/quality-gate is a REGULAR FILE.
writeFileSync(join(dir, "reports", "quality-gate"), qgReport, "utf-8");

const result = evidenceFindMissing(root, "demo", "T-001");
console.log("evidenceFindMissing(root, 'demo', 'T-001') ->");
console.log(JSON.stringify(result, null, 2));
console.log("");
console.log("Object.keys(result.data)                  = " + JSON.stringify(Object.keys(result.data)));
console.log('"undeterminable" in result.data           = ' + ("undeterminable" in result.data));
console.log("result.data.undeterminable                = " + String(result.data.undeterminable));
console.log("result.data.missing                       = " + JSON.stringify(result.data.missing));
console.log("");
console.log("--- the conflation issue #132 reports, shown directly ---");
console.log(
  'quality-gate-report-pass is in `missing`   = ' + result.data.missing.includes("quality-gate-report-pass"),
);
console.log("  (a directory-scan FAILURE, reported as if the evidence were simply absent)");
console.log("");

const state = parseTaskState(root, "demo", "specs/demo/tasks.md");
const reportsFailure =
  state.ok &&
  state.data.failures.some((f) => f.taskId === "T-001" && f.rule === "done-quality-gate-report-missing");
console.log("--- the parity side (parsers/task-validation.ts, unchanged) ---");
console.log("parseTaskState done-quality-gate-report-missing for T-001 = " + reportsFailure);
console.log("");
console.log("=> RED: `undeterminable` does not exist, so TEST-007's");
console.log("   `assert.deepEqual(data.undeterminable, ['quality-gate-report-pass'])`");
console.log("   and the union-form parity assertion cannot hold at this commit.");

rmSync(dir, { recursive: true, force: true });
