+function readonlyReviewLiteralProjection(cmd) {
+  // Pinned read-only CLI grammar, not a generic shell or prompt exemption.
+  // Keep write words. Only terminal single-quoted data loses redirect glyphs.
+  const match = new RegExp("^rtk proxy claude --model sonnet --effort medium --session-id [a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12} --print --output-format json --tools Read,Bash --allowedTools Read 'Bash\\(rtk proxy shasum -a 256 -- [A-Za-z0-9_./-]+(?: [A-Za-z0-9_./-]+)*\\)' 'Bash\\(rtk proxy printf %b '\\\\''[A-Za-z0-9_./\\\\-]+'\\\\''\\)' 'Bash\\(rtk proxy printf %s '\\\\''[A-Za-z0-9_|.-]+'\\\\''\\)' 'Bash\\(rtk proxy shasum -a 256\\)' 'Bash\\(rtk proxy test -d domain\\)' --disallowedTools Write,Edit,NotebookEdit --permission-mode dontAsk --debug-file /tmp/a8-impl-a[0-9]+r[0-9]+-[ab]-[0-9]{8}\\.log --append-system-prompt \"\\$\\(rtk proxy cat plugins/sdd-review-loop/agents/impl-reviewer-[ab]\\.md plugins/sdd-review-loop/references/review-context-boundary\\.md\\)\" -- ('(?:[^'\\x00]|'\\\\'')*')$").exec(cmd);
+  if (!match || match[0].length !== cmd.length) return cmd;
+  const prompt = match[1];
+  return cmd.slice(0, -prompt.length) + prompt.replace(/>/g, ' ');
+}
