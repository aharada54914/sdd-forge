                "name": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z][A-Za-z0-9_]{0,127})$(?![\\s\\S])"
                },
                "minimum": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "maximum": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
