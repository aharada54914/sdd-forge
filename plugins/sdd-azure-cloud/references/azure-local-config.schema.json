              "type": "string",
              "pattern": "^(?:/subscriptions/[a-f0-9-]{36}/resourceGroups/[A-Za-z0-9_-]+/providers/[A-Za-z.]+/(?:[A-Za-z0-9_.;-]+/)+[A-Za-z0-9_.;-]+)$(?![\\s\\S])"
            },
