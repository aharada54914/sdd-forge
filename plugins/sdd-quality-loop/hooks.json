{
  "sdd-soft-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/v2/sdd-soft-guard.mjs --emit antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
