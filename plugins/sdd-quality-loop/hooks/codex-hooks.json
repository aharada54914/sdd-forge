{
  "description": "SDD Forge v2 Lightweight Soft Guardrails for Codex CLI (ADR-0051). Single cross-platform Node.js ESM soft guard across POSIX and Windows.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/../../.sdd-compile-cache\" NODE_COMPILE_CACHE_PORTABLE=1 NODE_COMPILE_CACHE_READONLY=1 node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/v2/sdd-soft-guard.mjs\" --emit exit",
            "command_windows": "node -e \"const p=require('path'),cp=require('child_process');const r=process.env.CODEX_PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT||'';const env={...process.env,NODE_COMPILE_CACHE:p.join(r,'..','..','.sdd-compile-cache'),NODE_COMPILE_CACHE_PORTABLE:'1',NODE_COMPILE_CACHE_READONLY:'1'};const res=cp.spawnSync(process.execPath,[p.join(r,'scripts','v2','sdd-soft-guard.mjs'),'--emit','exit'],{stdio:'inherit',env});process.exit(res.status??1);\""
          }
        ]
      }
    ]
  }
}
