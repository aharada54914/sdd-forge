{
  "description": "SDD Forge v2 Lightweight Soft Guardrails for Codex CLI (ADR-0051). Single cross-platform Node.js ESM soft guard across POSIX and Windows.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/v2/sdd-soft-guard.mjs\" --emit exit",
            "command_windows": "node \"${CLAUDE_PLUGIN_ROOT}\\scripts\\v2\\sdd-soft-guard.mjs\" --emit exit"
          }
        ]
      }
    ]
  }
}
