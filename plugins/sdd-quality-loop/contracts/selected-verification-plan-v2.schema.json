{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "feature",
    "task_id",
    "profile_ref",
    "bindings",
    "checks",
    "selection_result",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "selected-verification-plan/v2"
    },
    "profile": {
      "const": "cloud"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:\\.[0-9]+){0,3}(?:-[A-Za-z0-9.-]+)?)$(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "verification_sha256",
        "registry_sha256"
      ],
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verification_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "iac-validate",
              "policy-validation",
              "iac-preview",
              "resource",
              "network",
              "identity",
              "monitoring",
              "workload",
              "backup"
            ]
          },
          "required": {
            "const": true
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.)(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|/|$))(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,254}(?<!\\.))*)$(?![\\s\\S])",
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{64})$(?![\\s\\S])"
              }
            }
          }
        }
      }
    },
    "selection_result": {
      "const": "PASS"
    },
    "verdict": {
      "enum": [
        "PASS",
        "NEEDS_WORK",
        "BLOCKED"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aharada54914/sdd-forge/contracts/selected-verification-plan-v2.schema.json"
}
