{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aharada54914/sdd-forge/contracts/lite-check-catalog.schema.json",
  "title": "Lite check catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog_version",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "lite-check-catalog/v1"
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
