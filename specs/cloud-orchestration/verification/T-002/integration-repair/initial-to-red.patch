+        endpoint["tool_schema"] = put("bundle/tool.json", b"fixture")
+    request["dependency_lock"] = put("bundle/lock.json", lock)
+    request["policy"] = put("bundle/policy.json", bodies["cloud-deployment-policy/v1"])
