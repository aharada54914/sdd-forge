+                    self.c.verify_local_context(self.root, request)
+                dest.write_bytes(data)
+        for value in ("", "relative", str(self.root / "..")):
+            with patch.dict(os.environ, {"CLOUD_WORKSPACE_ROOT": value}):
+                with self.assertRaises(self.c.ContractError):
