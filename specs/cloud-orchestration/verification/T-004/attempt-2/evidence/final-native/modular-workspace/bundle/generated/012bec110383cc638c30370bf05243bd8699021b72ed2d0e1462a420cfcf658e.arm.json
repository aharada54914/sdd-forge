{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "16812500148215234387"
    }
  },
  "parameters": {
    "vmName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "vmSize": {
      "type": "string"
    },
    "imageId": {
      "type": "string"
    },
    "adminUsername": {
      "type": "string"
    },
    "adminPublicKey": {
      "type": "string"
    },
    "subnetId": {
      "type": "string"
    },
    "identityId": {
      "type": "string"
    },
    "dataCollectionRuleId": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "backupPolicyId": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "private-unit",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "settings": {
            "value": {
              "vmName": "[parameters('vmName')]",
              "location": "[parameters('location')]",
              "vmSize": "[parameters('vmSize')]",
              "imageId": "[parameters('imageId')]",
              "adminUsername": "[parameters('adminUsername')]",
              "adminPublicKey": "[parameters('adminPublicKey')]",
              "subnetId": "[parameters('subnetId')]",
              "identityId": "[parameters('identityId')]",
              "dataCollectionRuleId": "[parameters('dataCollectionRuleId')]",
              "vaultName": "[parameters('vaultName')]",
              "backupPolicyId": "[parameters('backupPolicyId')]"
            }
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "1272739153593024402"
            }
          },
          "parameters": {
            "settings": {
              "type": "object"
            }
          },
          "variables": {
            "name": "[parameters('settings').vmName]"
          },
          "resources": [
            {
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2024-07-01",
              "name": "[variables('name')]",
              "location": "[parameters('settings').location]",
              "tags": {
                "purpose": "independent-module-case"
              },
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('settings').identityId)]": {}
                }
              },
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('settings').vmSize]"
                },
                "storageProfile": {
                  "imageReference": {
                    "id": "[parameters('settings').imageId]"
                  },
                  "osDisk": {
                    "createOption": "FromImage",
                    "managedDisk": {
                      "storageAccountType": "StandardSSD_LRS"
                    },
                    "diskSizeGB": 64,
                    "deleteOption": "Detach"
                  }
                },
                "osProfile": {
                  "computerName": "[variables('name')]",
                  "adminUsername": "[parameters('settings').adminUsername]",
                  "linuxConfiguration": {
                    "disablePasswordAuthentication": true,
                    "ssh": {
                      "publicKeys": [
                        {
                          "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('settings').adminUsername)]",
                          "keyData": "[parameters('settings').adminPublicKey]"
                        }
                      ]
                    }
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-internal', variables('name')))]"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-internal', variables('name')))]"
              ]
            },
            {
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}-internal', variables('name'))]",
              "location": "[parameters('settings').location]",
              "properties": {
                "enableIPForwarding": false,
                "enableAcceleratedNetworking": true,
                "ipConfigurations": [
                  {
                    "name": "internal",
                    "properties": {
                      "subnet": {
                        "id": "[parameters('settings').subnetId]"
                      },
                      "privateIPAllocationMethod": "Dynamic"
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Compute/virtualMachines/extensions",
              "apiVersion": "2024-07-01",
              "name": "[format('{0}/{1}', variables('name'), 'monitorAgent')]",
              "location": "[parameters('settings').location]",
              "properties": {
                "publisher": "Microsoft.Azure.Monitor",
                "type": "AzureMonitorLinuxAgent",
                "typeHandlerVersion": "1.0",
                "autoUpgradeMinorVersion": false,
                "enableAutomaticUpgrade": false,
                "settings": {
                  "authentication": {
                    "managedIdentity": {
                      "identifier-name": "mi_res_id",
                      "identifier-value": "[parameters('settings').identityId]"
                    }
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]"
              ]
            },
            {
              "type": "Microsoft.Insights/dataCollectionRuleAssociations",
              "apiVersion": "2023-03-11",
              "scope": "[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]",
              "name": "[format('{0}-signals', variables('name'))]",
              "properties": {
                "dataCollectionRuleId": "[parameters('settings').dataCollectionRuleId]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]"
              ]
            },
            {
              "type": "Microsoft.RecoveryServices/vaults/backupFabrics/protectionContainers/protectedItems",
              "apiVersion": "2024-04-01",
              "name": "[format('{0}/Azure/iaasvmcontainer;iaasvmcontainerv2;{1};{2}/vm;iaasvmcontainerv2;{3};{4}', parameters('settings').vaultName, resourceGroup().name, variables('name'), resourceGroup().name, variables('name'))]",
              "properties": {
                "protectedItemType": "Microsoft.Compute/virtualMachines",
                "sourceResourceId": "[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]",
                "policyId": "[parameters('settings').backupPolicyId]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]"
              ]
            }
          ]
        }
      }
    }
  ]
}