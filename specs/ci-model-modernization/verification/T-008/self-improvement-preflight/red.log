ETY_STEP_OUTCOME: ${{ steps.label_no_ci.outcome }}\n        run: |\n          if [ -n "$PREFLIGHT_REASON" ]; then\n            reason="$PREFLIGHT_REASON"\n          elif [ "$CLAUDE_STEP_OUTCOME" = failure ]; then\n            reason="Claude self-improvement action step failed. The issue report omits execution payload; inspect the action\'s sanitized run log."\n          elif [ "$COMPLETION_STEP_OUTCOME" = failure ]; then\n            reason="Audit completion evidence is missing, partial, invalid or reports incomplete verification. The audit has not recovered; inspect the session report and completion-step log."\n          elif [ "$GUARD_STEP_OUTCOME" = failure ]; then\n            reason="The enforcement-chain guard step failed. Inspect the run log for the guard\'s deterministic finding."\n          elif [ "$CI_SAFETY_STEP_OUTCOME" = failure ]; then\n            reason="The session-PR CI safety-net step failed. Inspect the run log for the failing command."\n          else\n            reason="A workflow step failed; inspect the run log for the failing step."\n          fi\n          run_url="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"\n          body="$(printf -- \'- 実行日時: %s\\n- 推定原因: %s\\n- 実行ログ: %s\' \\\n            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" "$run_url")"\n          gh label create self-improvement --color 1D76DB \\\n            --description "weekly automated audit" 2>/dev/null || true\n          existing="$(gh issue list --repo "$GITHUB_REPOSITORY" --state open \\\n            --search \'"Weekly self-improvement run failed" in:title\' \\\n            --json number --jq \'.[0].number // empty\')"\n          if [ -n "$existing" ]; then\n            gh issue comment "$existing" --repo "$GITHUB_REPOSITORY" \\\n              --body "$(printf -- \'再失敗:\\n%s\' "$body")"\n          else\n            gh issue create --repo "$GITHUB_REPOSITORY" \\\n              --title "Weekly self-improvement run failed ($(date -u +%Y-%m-%d)