+        }
+        else {
+            & tar -xzf $archivePath -C $temporaryRoot
+            if ($LASTEXITCODE -ne 0) {
+                throw "Downloaded archive extraction failed with exit code $LASTEXITCODE."
+            }
@@ -787,0 +829,3 @@ try {
