+def module(name, filename):
+    spec = importlib.util.spec_from_file_location(name, ROOT / 'tests' / filename)
+    assert spec and spec.loader
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
