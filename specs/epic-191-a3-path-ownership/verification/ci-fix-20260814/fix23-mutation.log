   --no-include-untracked fallback: 
   (master, both correct:  ["shared/tracked.ts","shared/untracked-probe.ts"] / ["shared/tracked.ts"])

-- [1] GREEN: fixed dispatcher --
   --include-untracked    fallback: ["shared/tracked.ts","shared/untracked-probe.ts"]
   --no-include-untracked fallback: ["shared/tracked.ts"]
   master                        : ["shared/tracked.ts","shared/untracked-probe.ts"] / ["shared/tracked.ts"]

