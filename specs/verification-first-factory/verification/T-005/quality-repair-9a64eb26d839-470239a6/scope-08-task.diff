+    if (token === '(*') {
+      const delimiters = /\(\*|\*\)/g;
+      delimiters.lastIndex = lexer.lastIndex;
+      let depth = 1;
+      while (depth) {
+        const next = delimiters.exec(config);
+        if (!next) throw new Error('Unterminated baseline CFG comment');
+        depth += next[0] === '(*' ? 1 : -1;
+      }
+      lexer.lastIndex = delimiters.lastIndex;
+    } else if (token === '"' || token === '*)') {
