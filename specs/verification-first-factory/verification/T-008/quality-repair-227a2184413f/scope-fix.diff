+function readBlock(fd, buffer, size) {
+  let offset = 0;
+  while (offset < size) {
+    const count = fs.readSync(fd, buffer, offset, size - offset, null);
+    if (count === 0) throw new Error('Rebuild output ended before the recorded size');
+    offset += count;
+  }
