+      git(projectRoot, ['worktree', 'add', '--quiet', '--detach', checkout, before.revision]);
+      try {
+        const baselineRoot = path.join(checkout, prefix);
+        const budget = readBudget(baselineRoot, rel, nfrBudgetPath !== null);
