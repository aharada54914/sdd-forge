+    const lines = normalizeNewlines(bytes.toString('utf8')).split('\n');
+    const additions = /\.(?:patch|diff)$/i.test(rel) ? addedUnifiedDiffLines(lines) : null;
     for (let i = 0; i < lines.length; i += 1) {
-      if (PLACEHOLDER_RE.test(lines[i])) {
