new file mode 100644
index 000000000..894f2ea32
--- /dev/null
+++ b/plugins/sdd-quality-loop/rules/rebuilt-catches.mjs
@@ -0,0 +1,107 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { createRequire, SourceMap } from 'node:module';
+import { parseSource } from './source-ast.mjs';
+
+// This compiler belongs to the lint tool checkout. Never load code or builders
+// from the project passed to --root. Missing build inputs leave diagnostics intact.
+const requireTool = createRequire(new URL('../../../mcp/sdd-forge-mcp/package.json', import.meta.url));
+const bundlePath = 'mcp/sdd-forge-mcp/dist/index.js';
+const maxBytes = 12 * 1024 * 1024;
+
+function documentedCatch(source, filename, entry) {
+  const catches = parseSource(source, filename).findAll({ rule: { kind: 'catch_clause' } });
+  for (const clause of catches) {
+    const start = clause.range().start;
+    if (start.line !== entry.originalLine || start.column < entry.originalColumn) continue;
+    // esbuild can map the entire generated '} catch' span to the preceding brace.
+    const prefix = source.split('\n')[start.line].slice(entry.originalColumn, start.column);
+    if (!/^}?\s*$/.test(prefix)) continue;
+    const body = clause.field('body');
+    const statements = body.namedChildren();
+    if (!statements.length || !statements.every(n => n.is('comment'))) continue;
+    const offset = body.range().start.index;
+    if (source[offset] === '{') return offset + 1;
+  }
+  return null;
+}
+
+async function verifiedLines(root, lines) {
+  const { build } = requireTool('./node_modules/esbuild');
+  const pkg = path.join(root, 'mcp/sdd-forge-mcp');
+  const dist = path.join(pkg, 'dist');
+  const options = { absWorkingDir: pkg, entryPoints: ['src/index.ts'], bundle: true, platform: 'node',
+    format: 'esm', outfile: 'dist/index.js', sourcemap: 'external', write: false, logLevel: 'silent' };
+  const first = await build(options);
+  const output = first.outputFiles.find(file => file.path === path.join(dist, 'index.js')).contents;
+  const original = fs.readFileSync(path.join(root, bundlePath));
+  if (!original.equals(output)) return [];
+  const committedBundle = execFileSync('git', ['-C', root, 'show', 'HEAD:' + bundlePath],
+    { maxBuffer: maxBytes, stdio: ['ignore', 'pipe', 'ignore'] });
+  if (!original.equals(committedBundle)) return [];
+  const sourceMap = JSON.parse(first.outputFiles.find(file => file.path.endsWith('.js.map')).text);
+  const map = new SourceMap(sourceMap);
+  const outputLines = original.toString('utf8').split('\n');
+  const edits = new Map();
+  const expected = new Map();
+  const prefix = 'sdd_lint_provenance_';
+  if (original.includes(prefix)) return [];
+
+  for (const line of lines) {
+    const text = outputLines[line - 1];
+    if (!/^\s*} catch(?: \([^)]*\))? \{$/.test(text)) continue;
+    const entry = map.findEntry(line - 1, text.indexOf('catch'));
+    if (typeof entry.originalSource !== 'string') continue;
+    const filename = path.resolve(dist, entry.originalSource);
+    const rel = path.relative(root, filename);
+    if (rel.startsWith('..' + path.sep) || path.isAbsolute(rel) || rel.split(path.sep).includes('node_modules')) continue;
+    if (!/\.(?:[cm]?[jt]s|[jt]sx)$/.test(rel) || fs.realpathSync(filename) !== filename) continue;
+    const embedded = sourceMap.sourcesContent[sourceMap.sources.indexOf(entry.originalSource)];
+    if (typeof embedded !== 'string' || fs.readFileSync(filename, 'utf8') !== embedded) continue;
+    const committed = execFileSync('git', ['-C', root, 'show', 'HEAD:' + rel.split(path.sep).join('/')],
+      { encoding: 'utf8', maxBuffer: maxBytes, stdio: ['ignore', 'pipe', 'ignore'] });
+    if (committed !== embedded || embedded.includes(prefix)) continue;
+    const offset = documentedCatch(embedded, filename, entry);
+    if (offset === null) continue;
+    const marker = prefix + line;
+    if (!edits.has(filename)) edits.set(filename, { source: embedded, changes: [] });
+    edits.get(filename).changes.push({ offset, marker });
+    expected.set(marker, line);
+  }
+  if (!edits.size) return [];
+
+  // Prove that changing this source catch changes this generated catch.
+  // A stale or misleading sourceMappingURL alone cannot satisfy this check.
+  const instrument = { name: 'verify-catch-origin', setup(build) {
+    build.onLoad({ filter: /\.[cm]?[jt]sx?$/ }, args => {
+      const edit = edits.get(args.path);
+      if (!edit) return;
+      let contents = edit.source;
+      for (const { offset, marker } of edit.changes.sort((a, b) => b.offset - a.offset)) {
+        contents = contents.slice(0, offset) + 'console.warn("' + marker + '");' + contents.slice(offset);
+      }
+      const ext = path.extname(args.path);
+      const loader = ext.endsWith('sx') ? ext.slice(1) : ext.endsWith('ts') ? 'ts' : 'js';
+      return { contents, loader, resolveDir: path.dirname(args.path) };
+    });
+  } };
+  // Both builds are in memory. Their outputs are compared as data and never run.
+  const second = await build({ ...options, plugins: [instrument] });
+  const regenerated = second.outputFiles.find(file => file.path === path.join(dist, 'index.js')).text;
+  const unmarked = [];
+  const verified = [];
+  for (const text of regenerated.split('\n')) {
+    const match = /^\s*console\.warn\("(sdd_lint_provenance_\d+)"\);$/.exec(text);
+    if (!match) { unmarked.push(text); continue; }
+    if (expected.get(match[1]) === unmarked.length) verified.push(unmarked.length);
+  }
+  return unmarked.join('\n') === original.toString('utf8') ? verified : [];
+}
+
+try {
+  const { root, lines } = JSON.parse(fs.readFileSync(0, 'utf8'));
+  process.stdout.write(JSON.stringify(await verifiedLines(root, lines)));
+} catch {
+  process.stdout.write('[]');
+}
diff --git a/plugins/sdd-quality-loop/rules/source-ast.mjs b/plugins/sdd-quality-loop/rules/source-ast.mjs
new file mode 100644
index 000000000..4fd383a96
--- /dev/null
+++ b/plugins/sdd-quality-loop/rules/source-ast.mjs
@@ -0,0 +1,18 @@
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+let parser;
+
+/** Parse a source file with the same grammar as the Layer 2/3 lint rules. */
+export function parseSource(source, filename = 'source.mjs') {
+  if (!parser) {
+    try {
+      parser = require('@ast-grep/napi');
+    } catch (cause) {
+      throw new Error('Agent Lint requires ast-grep. Run npm ci --prefix plugins/sdd-quality-loop/rules.', { cause });
+    }
+  }
+  const lang = /\.tsx$/i.test(filename) ? parser.Lang.Tsx
+    : /\.(?:ts|mts|cts)$/i.test(filename) ? parser.Lang.TypeScript : parser.Lang.JavaScript;
+  return parser.parse(lang, source).root();
+}
diff --git a/plugins/sdd-quality-loop/scripts/v2/run-agent-lint.mjs b/plugins/sdd-quality-loop/scripts/v2/run-agent-lint.mjs
new file mode 100644
index 000000000..3f53c74a7
--- /dev/null
+++ b/plugins/sdd-quality-loop/scripts/v2/run-agent-lint.mjs
@@ -0,0 +1,312 @@
+#!/usr/bin/env node
+/**
+ * run-agent-lint.mjs — Layer 2/3 Deterministic Agent-Strict Lint with Built-in Waivers (ADR-0054 T-004).
+ *
+ * Install the optional AST parser with npm ci --prefix plugins/sdd-quality-loop/rules.
+ * Layer 1 (`sdd-soft-guard.mjs`) remains untouched; this script runs in Layer 2/3
+ * (`sdd-gate` / CI) with `diff_only: true` by default and <= 3s per 100 files budget (NFR-004).
+ *
+ * Usage:
+ *   node run-agent-lint.mjs [--root <dir>] [--files <a,b>] [--diff-only] [--base-ref <commit>]
+ *                           [--mode off|shadow|warn|strict] [--format json|markdown]
+ *                           [--today YYYY-MM-DD]
+ *
+ * Exit codes:
+ *   0 — Pass (or shadow/warn/off mode)
+ *   1 — Strict mode failure (unwaived error, invalid expiry or expired waiver)
+ *   2 — Tool / argument error
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import {
+  globToRegExp,
+  isMainModule,
+  loadGuardrailsConfig,
+  normalizeRelPath,
+  resolveExplicitOrAutoRoot,
+} from './guardrails-lib.mjs';
+
+import { analyzeSource, readImports } from '../../rules/agent-lint-ast.mjs';
+import { changedHunks, LINTABLE } from '../../rules/lint-diff.mjs';
+import { dependencyCycles, projectFile } from '../../rules/local-module-graph.mjs';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const RULES_PATH = path.resolve(__dirname, '../../rules/agent-strict-rules.json');
+
+const IGNORED_DIRS = new Set(['.git', 'node_modules', 'dist', 'dist-test', 'build', '.next', '.worktrees']);
+
+function isCalendarDate(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const date = new Date(value + 'T00:00:00Z');
+  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
+}
+
+function loadRulesCatalog() {
+  const raw = JSON.parse(fs.readFileSync(RULES_PATH, 'utf8'));
+  return new Map(raw.rules.map(rule => [rule.id, rule]));
+}
+
+function describeFinding({ rule, line, snippet }, rel, rulesMap) {
+  const { severity, category, message, remediation_hint } = rulesMap.get(rule);
+  return { rule, severity, category, path: rel, line, message, remediation_hint, snippet };
+}
+
+export function lintSourceCode(source, relPath, rulesMap = loadRulesCatalog()) {
+  return analyzeSource(source, relPath).findings.map(finding => describeFinding(finding, relPath, rulesMap));
+}
+
+function collectFilesRecursive(root, relDir = '', out = []) {
+  const absDir = relDir ? path.join(root, ...relDir.split('/')) : root;
+  let entries;
+  try {
+    entries = fs.readdirSync(absDir, { withFileTypes: true });
+  } catch {
+    return out;
+  }
+  for (const entry of entries) {
+    if (IGNORED_DIRS.has(entry.name)) continue;
+    const childRel = relDir ? `${relDir}/${entry.name}` : entry.name;
+    if (entry.isDirectory()) {
+      collectFilesRecursive(root, childRel, out);
+    } else if (entry.isFile() && LINTABLE.test(entry.name)) {
+      out.push(childRel);
+    }
+  }
+  return out;
+}
+
+export function runAgentLint({
+  projectRoot = null,
+  files = null,
+  diffOnly = null,
+  baseRef = null,
+  mode = null,
+  today = null,
+} = {}) {
+  const startedAt = performance.now();
+  const root = fs.realpathSync(resolveExplicitOrAutoRoot(projectRoot));
+  const config = loadGuardrailsConfig(root);
+  const alCfg = config.agent_lint || {};
+  const effectiveMode = mode || (alCfg.enabled ? alCfg.mode : 'off');
+  if (!['off', 'shadow', 'warn', 'strict'].includes(effectiveMode)) throw new Error('Invalid Agent Lint mode');
+  const effectiveDiffOnly = typeof diffOnly === 'boolean' ? diffOnly : Boolean(alCfg.diff_only);
+  const todayStr = today ?? new Date().toISOString().slice(0, 10);
+  if (!isCalendarDate(todayStr)) throw new Error('--today requires a calendar date in YYYY-MM-DD format');
+
+  if (effectiveMode === 'off') {
+    return {
+      schema: 'sdd-agent-lint/v1',
+      mode: 'off',
+      status: 'SKIPPED',
+      scannedFiles: 0,
+      durationMs: Math.round(performance.now() - startedAt),
+      findings: [],
+      waived: [],
+      expiredWaivers: [],
+      invalidWaivers: [],
+    };
+  }
+
+  // --files alone intentionally checks complete files (an editor/fixture use).
+  // --files plus --diff-only restricts findings to the intersection.
+  const explicit = Array.isArray(files) ? [...new Set(files.map(normalizeRelPath).filter(p => LINTABLE.test(p)))] : null;
+  const useDiff = effectiveDiffOnly && (!explicit || diffOnly === true || baseRef);
+  const hunks = useDiff ? changedHunks(root, baseRef || 'HEAD') : null;
+  const targetRelFiles = explicit ?? (hunks ? [...hunks.keys()] : collectFilesRecursive(root));
+  const inScope = (rel, { line, endLine }) => !hunks ||
+    hunks.get(rel)?.some(([start, end]) => start <= endLine && line <= end);
+
+  const rulesMap = loadRulesCatalog();
+  const waivers = Array.isArray(alCfg.waivers) ? alCfg.waivers : [];
+  const expiredWaivers = [];
+  const invalidWaivers = [];
+  const activeWaivers = [];
+
+  for (const w of waivers) {
+    if (!w || typeof w !== 'object' || !w.rule || !w.path) continue;
+    const exp = w.expires_on;
+    if (!isCalendarDate(exp)) {
+      invalidWaivers.push({
+        code: 'INVALID_WAIVER_EXPIRY',
+        rule: String(w.rule),
+        path: String(w.path),
+        expires_on: exp ?? null,
+        message: 'Waiver の有効期限が不正です',
+        remediation_hint: 'expires_on に実在する日付を YYYY-MM-DD 形式で指定してください',
+      });
+      continue;
+    }
+    if (exp < todayStr) {
+      expiredWaivers.push({
+        code: 'EXPIRED_WAIVER',
+        rule: String(w.rule),
+        path: String(w.path),
+        expires_on: exp,
+        message: `Waiver (${w.rule} @ ${w.path}) の有効期限 (${exp}) が切れています (today=${todayStr})`,
+        remediation_hint: '違反を修正して guardrails.yaml から waiver を削除するか、人間承認のもとで期限を更新してください',
+      });
+    } else {
+      activeWaivers.push({
+        rule: String(w.rule),
+        pathRe: globToRegExp(String(w.path)),
+        rawPath: String(w.path),
+        expires_on: exp,
+        reason: String(w.reason || ''),
+      });
+    }
+  }
+
+  const findings = [];
+  const waived = [];
+  const cache = new Map();
+  const cycleSeeds = [];
+  let scannedFiles = 0;
+  function analyze(rel) {
+    if (!cache.has(rel)) {
+      const file = projectFile(root, rel);
+      if (!file) throw new Error(`Cannot inspect project file: ${rel}`);
+      const reportTool = !explicit && rel.endsWith('.mjs') &&
+        (rel.startsWith('tests/') || rel.startsWith('reports/verification/'));
+      cache.set(rel, analyzeSource(fs.readFileSync(file, 'utf8'), rel, {
+        maxDepth: alCfg.max_abstraction_depth,
+        allowJsonReportOutput: reportTool,
+      }));
+    }
+    return cache.get(rel);
+  }
+  function add(rel, raw) {
+    const f = describeFinding(raw, rel, rulesMap);
+    const waiver = activeWaivers.find(w => w.rule === f.rule && w.pathRe.test(rel));
+    if (waiver) {
+      waived.push({ ...f, waiver: { path: waiver.rawPath, expires_on: waiver.expires_on, reason: waiver.reason } });
+    } else {
+      findings.push(f);
+    }
+  }
+  for (const rel of targetRelFiles) {
+    if (hunks && !hunks.has(rel)) continue;
+    const file = analyze(rel);
+    scannedFiles += 1;
+    const scoped = file.findings.filter(finding => inScope(rel, finding));
+    let documentedLines = [];
+    if (!explicit && rel === 'mcp/sdd-forge-mcp/dist/index.js') {
+      const lines = scoped.filter(f => f.rule === 'no-empty-catch').map(f => f.line);
+      if (lines.length) {
+        const worker = fileURLToPath(new URL('../../rules/rebuilt-catches.mjs', import.meta.url));
+        const result = spawnSync(process.execPath, [worker], {
+          input: JSON.stringify({ root, lines }), encoding: 'utf8', timeout: 2000, maxBuffer: 1024 * 1024,
+        });
+        if (result.status === 0 && /^\[(?:\d+(?:,\d+)*)?\]$/.test(result.stdout)) {
+          documentedLines = JSON.parse(result.stdout);
+        }
+      }
+    }
+    for (const finding of scoped) {
+      if (finding.rule === 'no-empty-catch' && documentedLines.includes(finding.line)) continue;
+      add(rel, finding);
+    }
+    if (file.imports.some(edge => inScope(rel, edge))) cycleSeeds.push(rel);
+  }
+  const importsFor = rel => cache.get(rel)?.imports ?? readImports(fs.readFileSync(projectFile(root, rel), 'utf8'), rel);
+  for (const finding of dependencyCycles(root, cycleSeeds, importsFor, inScope)) add(finding.path, finding);
+
+  const waiverErrors = expiredWaivers.length > 0 || invalidWaivers.length > 0;
+  const hasErrors = findings.some((f) => f.severity === 'error') || waiverErrors;
+  const status =
+    hasErrors && effectiveMode === 'strict'
+      ? 'FAIL'
+      : findings.length > 0 || waiverErrors
+        ? 'WARN'
+        : 'PASS';
+
+  return {
+    schema: 'sdd-agent-lint/v1',
+    mode: effectiveMode,
+    status,
+    scannedFiles,
+    durationMs: Math.round(performance.now() - startedAt),
+    findings,
+    waived,
+    expiredWaivers,
+    invalidWaivers,
+  };
+}
+
+export function formatAgentLintMarkdown(report) {
+  const lines = [
+    `## Agent-Strict Lint — \`${report.status}\` (mode: \`${report.mode}\`)`,
+    '',
+    `- **Scanned Files**: ${report.scannedFiles} (${report.durationMs}ms)`,
+    `- **Findings**: ${report.findings.length} / **Waived**: ${report.waived.length} / **Expired Waivers**: ${report.expiredWaivers.length}`,
+  ];
+  if (report.invalidWaivers?.length) {
+    lines.push('', '### Invalid Waiver Expiry Dates');
+    for (const w of report.invalidWaivers) {
+      lines.push(`- **${w.rule}** (\`${w.path}\`): ${w.message}`, `  - Hint: ${w.remediation_hint}`);
+    }
+  }
+  if (report.expiredWaivers.length > 0) {
+    lines.push('', '### Expired Waivers');
+    for (const ew of report.expiredWaivers) {
+      lines.push(`- **${ew.rule}** (\`${ew.path}\`, expired \`${ew.expires_on}\`): ${ew.message}`);
+      lines.push(`  - Hint: ${ew.remediation_hint}`);
+    }
+  }
+  if (report.findings.length > 0) {
+    lines.push('', '### Findings');
+    for (const f of report.findings) {
+      lines.push(`- **[${f.severity.toUpperCase()}] ${f.rule}** (\`${f.path}:L${f.line}\`): ${f.message}`);
+      lines.push(`  - Hint: ${f.remediation_hint}`);
+    }
+  }
+  return `${lines.join('\n')}\n`;
+}
+
+function parseArgs(argv) {
+  const opts = {
+    root: null,
+    files: null,
+    diffOnly: null,
+    mode: null,
+    format: 'json',
+    today: null,
+  };
+  for (let i = 0; i < argv.length; i += 1) {
+    const a = argv[i];
+    if (a === '--root' && argv[i + 1]) opts.root = argv[++i];
+    else if (a === '--files' && argv[i + 1]) opts.files = argv[++i].split(',').map((s) => s.trim()).filter(Boolean);
+    else if (a === '--base-ref' && argv[i + 1]) opts.baseRef = argv[++i];
+    else if (a === '--diff-only') opts.diffOnly = true;
+    else if (a === '--all') opts.diffOnly = false;
+    else if (a === '--mode' && argv[i + 1]) opts.mode = argv[++i];
+    else if (a === '--format' && ['json', 'markdown'].includes(argv[i + 1])) opts.format = argv[++i];
+    else if (a === '--today' && argv[i + 1]) opts.today = argv[++i];
+    else throw new Error(`Unknown or incomplete option: ${a}`);
+  }
+  return opts;
+}
+
+if (isMainModule(import.meta.url, 'run-agent-lint.mjs')) {
+  try {
+    const opts = parseArgs(process.argv.slice(2));
+    const report = runAgentLint({
+      projectRoot: opts.root || process.cwd(),
+      files: opts.files,
+      diffOnly: opts.diffOnly,
+      baseRef: opts.baseRef,
+      mode: opts.mode,
+      today: opts.today,
+    });
+    if (opts.format === 'markdown') {
+      process.stdout.write(formatAgentLintMarkdown(report));
+    } else {
+      process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+    }
+    process.exit(report.status === 'FAIL' ? 1 : 0);
+  } catch (err) {
+    process.stderr.write(`run-agent-lint error: ${err.message}\n`);
+    process.exit(2);
+  }
+}
