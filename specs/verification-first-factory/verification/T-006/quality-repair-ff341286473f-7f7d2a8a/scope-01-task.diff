--- /dev/null
+++ b/specs/self-verification/formal/TaskLock.tla
@@ -0,0 +1,62 @@
+--------------------------- MODULE TaskLock ---------------------------
+EXTENDS Naturals, FiniteSets
+CONSTANT
+    \* @type: Bool;
+    UseAtomicLock
+Owners == {"w1", "w2"}
+VARIABLES
+    \* @type: Str;
+    holder,
+    \* @type: Bool;
+    leaseActive,
+    \* @type: Set(Str);
+    holders
+
+\* Explicit frame equalities let Apalache use these actions as trace predicates
+\* even after Next has already assigned the successor state.
+vars == <<holder, leaseActive, holders>>
+
+Init ==
+    /\ holder = "none"
+    /\ leaseActive = FALSE
+    /\ holders = {}
+
+Acquire(o) ==
+    /\ o \notin holders
+    /\ IF UseAtomicLock THEN holder = "none" ELSE TRUE
+    /\ holder' = o
+    /\ leaseActive' = TRUE
+    /\ holders' = holders \cup {o}
+
+Renew(o) ==
+    /\ holder = o
+    /\ leaseActive' = TRUE
+    /\ holder' = holder /\ holders' = holders
+
+Expire ==
+    /\ holder /= "none"
+    /\ leaseActive = TRUE
+    /\ leaseActive' = FALSE
+    /\ holder' = holder /\ holders' = holders
+
+ReclaimStale(o) ==
+    /\ holder /= "none"
+    /\ leaseActive = FALSE
+    /\ holder' = o
+    /\ leaseActive' = TRUE
+    /\ holders' = {o}
+
+Release(o) ==
+    /\ holder = o
+    /\ holder' = "none"
+    /\ leaseActive' = FALSE
+    /\ holders' = holders \ {o}
+
+Next ==
+    \/ \E o \in Owners : Acquire(o) \/ Renew(o) \/ ReclaimStale(o) \/ Release(o)
+    \/ Expire
+
+Spec == Init /\ [][Next]_vars
+
+SingleOwner == Cardinality(holders) <= 1
+=============================================================================
