  # Windows version gates use separate runners so the four deterministic
  # lanes do not contend for one runner's CPU.
  version-gates-windows-bump:
    name: version-gates-windows-bump
    runs-on: windows-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Test bump-version.sh loop-gate prerequisite (bash + pwsh, parallel)
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $workDir = (Get-Location).Path
          $logRoot = Join-Path $env:RUNNER_TEMP 'bump-version-gate-parallel'
          $bashOut = "$logRoot-bash.out"
          $bashErr = "$logRoot-bash.err"
          $pwshOut = "$logRoot-pwsh.out"
          $pwshErr = "$logRoot-pwsh.err"
          $processes = @()
          $bash = $null
          $pwsh = $null
          $launchError = $null
          $deadline = [DateTime]::UtcNow.AddMinutes(20)
          try {
            $bashPath = (Get-Command bash -ErrorAction Stop).Path
            $bash = Start-Process -FilePath $bashPath `
              -ArgumentList @('./tests/bump-version-gate.tests.sh') `
              -WorkingDirectory $workDir `
              -RedirectStandardOutput $bashOut `
              -RedirectStandardError $bashErr `
              -PassThru
            $processes += $bash
            $pwshPath = (Get-Command pwsh -ErrorAction Stop).Path
            $pwsh = Start-Process -FilePath $pwshPath `
              -ArgumentList @('-NoProfile', '-NonInteractive', '-File', './tests/bump-version-gate.tests.ps1') `
              -WorkingDirectory $workDir `
              -RedirectStandardOutput $pwshOut `
              -RedirectStandardError $pwshErr `
              -PassThru
            $processes += $pwsh
            while (@($processes | Where-Object { -not $_.HasExited }).Count -gt 0) {
              if ([DateTime]::UtcNow -ge $deadline) {
                throw 'bump-version-gate timed out after 20 minutes'
              }
              Start-Sleep -Seconds 1
            }
          } catch {
            $launchError = $_
          } finally {
            foreach ($process in $processes) {
              if (-not $process.HasExited) {
                try { $process.Kill($true) } catch { $process.Kill() }
                $process.WaitForExit()
              }
            }
          }
          Write-Host '=== bump-version-gate Bash output ==='
          if (Test-Path -LiteralPath $bashOut) { Get-Content -LiteralPath $bashOut }
          if (Test-Path -LiteralPath $bashErr) { Get-Content -LiteralPath $bashErr }
          Write-Host '=== bump-version-gate PowerShell output ==='
          if (Test-Path -LiteralPath $pwshOut) { Get-Content -LiteralPath $pwshOut }
          if (Test-Path -LiteralPath $pwshErr) { Get-Content -LiteralPath $pwshErr }
          if ($launchError) { throw $launchError }
          $bashExit = if ($bash) { $bash.ExitCode } else { 'not-started' }
          $pwshExit = if ($pwsh) { $pwsh.ExitCode } else { 'not-started' }
          if (-not $bash -or -not $pwsh -or $bashExit -ne 0 -or $pwshExit -ne 0) {
            throw "bump-version-gate failed (bash=$bashExit, pwsh=$pwshExit)"
          }

      - name: Test release.yml required loop-gate job (bash)
        shell: bash
        run: bash ./tests/release-loop-gate.tests.sh

  version-gates-windows-lanes:
    name: version-gates-windows-lanes (${{ matrix.lane }})
    strategy:
      fail-fast: false
      matrix:
        lane: [governance, capability, ownership, lite]
    runs-on: windows-latest
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Test Windows version-gates lane
        shell: pwsh
        run: ./tests/run-version-gates-windows.ps1 -Lane ${{ matrix.lane }}

  # mcp-tests — sdd-forge-mcp (mcp/sdd-forge-mcp/) is the repo's first
  # Node/TypeScript component: a read-only MCP server exposing SDD workflow
  # state. Its tasks.md state-machine parser must stay shell-equivalent with
  # check-task-state.sh (golden tests), so it is exercised across the same
  # 3-OS matrix as the rest of the suite. On POSIX runners the golden tests
  # execute the real shell scripts; on Windows they compare against recorded
  # fixtures (process.platform branch inside the test suite itself).
  mcp-tests:
    name: mcp-tests
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, macos-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    defaults:
      run:
        working-directory: mcp/sdd-forge-mcp
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Full history: the golden task-state tests exercise
          # check-evidence-bundle, which resolves each bundle's recorded
          # git_commit binding via git; a shallow clone cannot see them.
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: mcp/sdd-forge-mcp/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Type check
        run: npx tsc --noEmit

      - name: Run tests
        run: npm test

      # dist-parity (AC-010): rebuild the esbuild bundle and confirm the
      # working tree's committed dist/index.js is reproducible from source.
      # Runs once on Linux to keep the check OS-agnostic and fast; esbuild
      # output is deterministic across platforms for this bundle.
      - name: Rebuild dist and verify parity
        if: matrix.os == 'ubuntu-latest'
        run: |
          npm run build
          git diff --exit-code -- dist/

      - name: Audit production dependencies
        if: matrix.os == 'ubuntu-latest'
        run: npm audit --omit=dev --audit-level=high

  # B2 — exercise the SDD hook guard with the REAL CLI toolchains installed on
  # each OS, through the exact command line each CLI's hook config invokes. This
  # closes the gap that the unit/scenario suites only run the guard scripts in
  # isolation; here Claude Code / Codex / Copilot binaries are actually present.
  # (A live agent session that fires the hook needs an API-key secret and is
  # non-deterministic, so it is not gated here — the deterministic enforcement
  # below is what protects the branch.)
  # local-env-mcp-tests — local-env-mcp (mcp/local-env-mcp/) is a read-only
  # MCP server exposing local environment info (OS, toolchain versions, CLI
  # availability) with no execution capability (ADR-0003/ADR-0004 pattern,
  # same shape as sdd-forge-mcp). Exercised across the same 3-OS matrix as
  # sdd-forge-mcp's mcp-tests job.
  local-env-mcp-tests:
    name: local-env-mcp-tests
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, macos-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    defaults:
      run:
        working-directory: mcp/local-env-mcp
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: mcp/local-env-mcp/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Type check
        run: npx tsc --noEmit

      - name: Run tests
        run: npm test

      # dist-parity (AC-008): rebuild the esbuild bundle and confirm the
      # working tree's committed dist/index.js is reproducible from source.
      # Runs once on Linux to keep the check OS-agnostic and fast; esbuild
      # output is deterministic across platforms for this bundle (verified
      # locally: two independent builds produced an identical SHA-256).
      - name: Rebuild dist and verify parity
        if: matrix.os == 'ubuntu-latest'
        run: |
          npm run build
          git diff --exit-code -- dist/

      - name: Audit production dependencies
        if: matrix.os == 'ubuntu-latest'
        run: npm audit --omit=dev --audit-level=high

  # ci-mcp-tests — ci-mcp (mcp/ci-mcp/) is a read-only MCP server exposing
  # GitHub Actions CI state (workflow runs, jobs, job logs, artifacts
  # metadata) over a GET-only api.github.com client (ADR-0003 pattern, same
  # shape as sdd-forge-mcp / local-env-mcp). Exercised across the same 3-OS
  # matrix; its own test suite (fake GitHub API fixtures) makes no real
  # network call, so CI stays outbound-connection-free (design.md
  # "Deployment / CI Plan").
  ci-mcp-tests:
    name: ci-mcp-tests
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, macos-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    defaults:
      run:
        working-directory: mcp/ci-mcp
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: mcp/ci-mcp/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Type check
        run: npx tsc --noEmit

      # Includes the AC-015 Inspector CLI smoke test (tests/smoke/), which
      # spawns the bundled dist/index.js over real stdio — its before()
      # hook builds dist/ on demand if absent, so this step alone is
      # sufficient even before the parity step below runs.
      - name: Run tests
        run: npm test

      # dist-parity (AC-014): rebuild the esbuild bundle and confirm the
      # working tree's committed dist/index.js is reproducible from source.
      # Runs once on Linux to keep the check OS-agnostic and fast; esbuild
      # output is deterministic across platforms for this bundle (verified
      # locally: two independent builds produced an identical SHA-256).
      - name: Rebuild dist and verify parity
        if: matrix.os == 'ubuntu-latest'
        run: |
          npm run build
          git diff --exit-code -- dist/

      - name: Audit production dependencies
        if: matrix.os == 'ubuntu-latest'
        run: npm audit --omit=dev --audit-level=high

  cli-hook-enforcement:
    name: cli-hook-enforcement
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, macos-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Install Claude Code CLI
        shell: bash
        run: npm install -g @anthropic-ai/claude-code

      - name: Install Codex CLI (best-effort)
        shell: bash
        continue-on-error: true
        run: npm install -g @openai/codex

      - name: Install Copilot CLI (best-effort)
        shell: bash
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh extension install github/gh-copilot

      - name: CLI hook enforcement (real toolchain present)
        shell: pwsh
        run: ./tests/cli-hook-enforcement.ps1

  required-checks:
    name: required-checks
    if: always()
    needs: [test, test-windows-heavy, installers, loops-routing, version-gates, version-gates-windows-bump, version-gates-windows-lanes, mcp-tests, local-env-mcp-tests, ci-mcp-tests, cli-hook-enforcement, posix-regression]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check all required tests passed
        run: |
          if [ "${{ needs.test.result }}" != "success" ]; then
            echo "test job failed"
            exit 1
          fi
          if [ "${{ needs.test-windows-heavy.result }}" != "success" ]; then
            echo "test-windows-heavy job failed"
            exit 1
          fi
          if [ "${{ needs.installers.result }}" != "success" ]; then
            echo "installers job failed"
            exit 1
          fi
          if [ "${{ needs.loops-routing.result }}" != "success" ]; then
            echo "loops-routing job failed"
            exit 1
          fi
          if [ "${{ needs.version-gates.result }}" != "success" ]; then
            echo "version-gates job failed"
            exit 1
          fi
          if [ "${{ needs.version-gates-windows-bump.result }}" != "success" ]; then
            echo "version-gates-windows-bump job failed"
            exit 1
          fi
          if [ "${{ needs.version-gates-windows-lanes.result }}" != "success" ]; then
            echo "version-gates-windows-lanes job failed"
            exit 1
          fi
          if [ "${{ needs.mcp-tests.result }}" != "success" ]; then
            echo "mcp-tests job failed"
            exit 1
          fi
          if [ "${{ needs.local-env-mcp-tests.result }}" != "success" ]; then
            echo "local-env-mcp-tests job failed"
            exit 1
          fi
          if [ "${{ needs.ci-mcp-tests.result }}" != "success" ]; then
            echo "ci-mcp-tests job failed"
            exit 1
          fi
          if [ "${{ needs.cli-hook-enforcement.result }}" != "success" ]; then
            echo "cli-hook-enforcement job failed"
            exit 1
          fi
          if [ "${{ needs.posix-regression.result }}" != "success" ]; then
            echo "posix-regression job failed"
            exit 1
          fi
          echo "all required checks passed"
  # Keep the Windows-only deterministic suites in a parallel job.
  # Their assertions remain required by required-checks.
  test-windows-heavy:
    name: test-windows-heavy
    runs-on: windows-latest
    timeout-minutes: 15
    steps:
      - name: "[deterministic] Setup step 1"
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: "[deterministic] Test deterministic gate scripts"
        shell: pwsh
        run: ./tests/scripts.tests.ps1
      - name: "[deterministic] Test portable review-loop prechecks"
        shell: pwsh
        run: |
          ./tests/review-contract-foundation.tests.ps1
          ./tests/downstream-review-precheck.tests.ps1
          ./tests/impl-layer-review-inputs.tests.ps1
          ./tests/task-layer-review-inputs.tests.ps1
      - name: "[deterministic] Test cross-model gate"
        shell: pwsh
        run: ./tests/cross-model.tests.ps1
      - name: "[deterministic] Test hook guards"
        shell: pwsh
        run: ./tests/hooks.tests.ps1
      - name: "[deterministic] Test panelist-input consent gate"
        shell: pwsh
        run: ./tests/prepare-panelist.tests.ps1
