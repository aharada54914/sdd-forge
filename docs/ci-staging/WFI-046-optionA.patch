 # ---------------------------------------------------------------------------
+# Check 3 (WFI-046): executing-syntax disqualifier drift invariant.
+# The guard grants two read-only-shaped exemptions (the WFI-022 approval
+# exemption and the protected-file short-circuit). Both must reference the
+# SAME named disqualifier constant in each guard runtime, and the raw
+# pattern literal must appear exactly once per runtime (the named
+# definition), so the two gates cannot silently drift apart again — which is
+# how the WFI-046 bypass arose. Source-level by design: the guard emits one
+# verdict per payload, so behaviour alone cannot show both gates carry it.
+# ---------------------------------------------------------------------------
+GUARD_PY="${SCRIPTS_DIR}/sdd-hook-guard.py"
+GUARD_JS="${SCRIPTS_DIR}/sdd-hook-guard.js"
+GUARD_PS1="${SCRIPTS_DIR}/sdd-hook-guard.ps1"
+
+check_disqualifier() {
+    local label="$1" file="$2" name="$3" min_refs="$4"
+    local raw_literal='<\(|>\('
+    local refs=0 defs=0
+    refs="$(grep -c -- "$name" "$file" || true)"
+    defs="$(grep -cF -- "$raw_literal" "$file" || true)"
+    if [ "${refs:-0}" -lt "$min_refs" ]; then
+        fail "disqualifier [$label]: $name referenced on $refs line(s), expected >= $min_refs (definition + both exemption sites)"
+    elif [ "${defs:-0}" -ne 1 ]; then
+        fail "disqualifier [$label]: raw pattern literal on $defs line(s), expected exactly 1 (the named definition)"
+    else
+        ok "disqualifier [$label]: $name shared by both exemption sites; single raw definition"
+    fi
+}
+
+check_disqualifier "py"  "$GUARD_PY"  "WFI_EXEMPTION_UNSAFE_RE" 3
+check_disqualifier "js"  "$GUARD_JS"  "WFI_EXEMPTION_UNSAFE_RE" 3
+check_disqualifier "ps1" "$GUARD_PS1" "WfiExemptionUnsafeRe" 3
+
+# ---------------------------------------------------------------------------
 # Summary
 # ---------------------------------------------------------------------------
 echo ""
