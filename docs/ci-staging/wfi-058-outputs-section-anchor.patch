+        if ($LASTEXITCODE -eq 0 -and $fallback) { $anchor = ([string]$fallback).Trim() }
+    }
+    if (-not $anchor) { return $null }
+
+    $script:PpiDeclCommit = $anchor
     return $script:PpiDeclCommit
 }
 
