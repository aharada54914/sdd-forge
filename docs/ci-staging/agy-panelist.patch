Subject: feat(cross-model): Antigravity CLI (agy) fallback for the Google panelist slot

gemini-cli's consumer backend was retired server-side on 2026-06-18
("migrate to the Antigravity suite"). The owner installed Antigravity;
agy 1.1.22's print mode was verified live to carry the exact contract
run-panelist-gemini already uses: `-p <prompt>` non-interactive, with
stdin appended after the prompt. This patch teaches the four protected
collection scripts to fall back to agy when the gemini CLI is absent:

  - detect-panel.{sh,ps1}: the google slot is detected when either CLI
    answers --version (slug stays "gemini");
  - run-panelist-gemini.{sh,ps1}: CLI selection with graceful degrade,
    and the default model re-pinned to gemini-3.1-pro-high under agy —
    an explicit Gemini id, because agy also serves non-Google models
    and this runner IS the google vendor slot.

Behaviour with the gemini CLI installed is byte-for-byte unchanged.

Apply from the repository root:

    git apply --check docs/ci-staging/agy-panelist.patch
    git apply docs/ci-staging/agy-panelist.patch

---
--- a/plugins/sdd-quality-loop/scripts/detect-panel.sh	2026-08-29 00:03:01
+++ b/plugins/sdd-quality-loop/scripts/detect-panel.sh	2026-08-29 00:03:01
@@ -69,6 +69,12 @@
 if command -v gemini >/dev/null 2>&1 && gemini --version >/dev/null 2>&1; then
     found="${found}gemini
 "
+elif command -v agy >/dev/null 2>&1 && agy --version >/dev/null 2>&1; then
+    # Antigravity CLI (agy) serves the Google vendor slot since gemini-cli's
+    # consumer backend retirement (2026-06-18); run-panelist-gemini falls back
+    # to it with the same -p/stdin contract, so the slug stays "gemini".
+    found="${found}gemini
+"
 fi
 
 # ── Emit results ─────────────────────────────────────────────────────────────
@@ -78,9 +84,9 @@
     exit 0
 else
     if [ "$quiet" = "0" ]; then
-        printf 'detect-panel: WARNING: no non-Anthropic panelist CLIs found (codex/gemini not in PATH).\n' >&2
+        printf 'detect-panel: WARNING: no non-Anthropic panelist CLIs found (codex/gemini/agy not in PATH).\n' >&2
         printf 'detect-panel: The cross-model gate requires >= 1 non-Anthropic vendor verdict.\n' >&2
-        printf 'detect-panel: Install codex or gemini CLI, or provide manual verdict JSONs.\n' >&2
+        printf 'detect-panel: Install codex, gemini or agy (Antigravity) CLI, or provide manual verdict JSONs.\n' >&2
     fi
     exit 1
 fi
--- a/plugins/sdd-quality-loop/scripts/detect-panel.ps1	2026-08-29 00:03:01
+++ b/plugins/sdd-quality-loop/scripts/detect-panel.ps1	2026-08-29 00:03:01
@@ -72,8 +72,14 @@
 # ── Detect: Gemini panelist via gemini CLI ──────────────────────────────────
 # `--version` is a cheap liveness probe (never invokes a model).
 $geminiCmd = Get-Command "gemini" -ErrorAction SilentlyContinue
+$agyCmd = Get-Command "agy" -ErrorAction SilentlyContinue
 if ($geminiCmd -and (Test-CliVersion $geminiCmd.Source)) {
     $found.Add("gemini")
+} elseif ($agyCmd -and (Test-CliVersion $agyCmd.Source)) {
+    # Antigravity CLI (agy) serves the Google vendor slot since gemini-cli's
+    # consumer backend retirement (2026-06-18); the runner falls back to it
+    # with the same -p/stdin contract, so the slug stays "gemini".
+    $found.Add("gemini")
 }
 
 # ── Emit results ─────────────────────────────────────────────────────────────
--- a/plugins/sdd-quality-loop/scripts/run-panelist-gemini.sh	2026-08-29 00:03:01
+++ b/plugins/sdd-quality-loop/scripts/run-panelist-gemini.sh	2026-08-29 00:03:01
@@ -75,8 +75,25 @@
 
 # ── Check CLI availability ───────────────────────────────────────────────────
 
-if ! command -v gemini >/dev/null 2>&1; then
-    printf 'run-panelist-gemini: gemini CLI not found in PATH — skipping Gemini panelist (graceful degrade)\n' >&2
+_gemini_cli=""
+if command -v gemini >/dev/null 2>&1; then
+    _gemini_cli="gemini"
+elif command -v agy >/dev/null 2>&1; then
+    # Antigravity CLI fallback (2026-08-29): gemini-cli's consumer backend was
+    # retired server-side on 2026-06-18. agy's print mode carries the same
+    # contract this runner already uses — `-p <prompt>` with the sanitized
+    # bundle piped on stdin and appended after the prompt (verified live
+    # against agy 1.1.22). The model is re-pinned to an explicit Gemini id
+    # because agy also serves non-Google models and this runner IS the
+    # google vendor slot; a non-Gemini default would silently break the
+    # cross-model gate's vendor-diversity meaning.
+    _gemini_cli="agy"
+    if [ "$model" = "gemini-2.0-flash" ]; then
+        model="gemini-3.1-pro-high"
+    fi
+fi
+if [ -z "$_gemini_cli" ]; then
+    printf 'run-panelist-gemini: neither gemini nor agy CLI found in PATH — skipping Gemini panelist (graceful degrade)\n' >&2
     exit 1
 fi
 if ! command -v python3 >/dev/null 2>&1; then
@@ -161,11 +178,11 @@
 } > "$_stdin_bundle"
 _prompt_text="$(cat "$_prompt_file")"
 
-printf 'run-panelist-gemini: invoking gemini --model %s -p <prompt> (task=%s feature=%s)\n' \
-    "$model" "$task_id" "$feature" >&2
+printf 'run-panelist-gemini: invoking %s --model %s -p <prompt> (task=%s feature=%s)\n' \
+    "$_gemini_cli" "$model" "$task_id" "$feature" >&2
 
 _raw_output="${_scratch}/raw-output.txt"
-_sdd_run_bounded "$_panelist_timeout" gemini --model "$model" -p "$_prompt_text" \
+_sdd_run_bounded "$_panelist_timeout" "$_gemini_cli" --model "$model" -p "$_prompt_text" \
     < "$_stdin_bundle" > "$_raw_output" 2>&1
 _rc=$?
 if [ "$_rc" -ne 0 ]; then
