{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coding standards population snapshot; shape validation is not review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "base_commit",
    "generated_at",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "coding-standards-population/v1"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "git_blob",
          "source_sha256",
          "classification",
          "surfaces",
          "state",
          "owner_issue",
          "evidence",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "git_blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "classification": {
            "enum": [
              "asset",
              "current-code",
              "current-config",
              "current-guidance",
              "current-template",
              "current-test",
              "historical",
              "protected-human-copy"
            ]
          },
          "surfaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state": {
            "enum": [
              "unreviewed",
              "needs-review",
              "confirmed-violation",
              "false-positive",
              "fixed",
              "justified-exception",
              "out-of-scope",
              "reviewed"
            ]
          },
          "owner_issue": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "confirmed-violation",
                    "false-positive",
                    "fixed",
                    "justified-exception",
                    "out-of-scope",
                    "reviewed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
