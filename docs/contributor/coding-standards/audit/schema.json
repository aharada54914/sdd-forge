{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coding standards findings; metadata is not completion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "coding-standards-findings/v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "rule_id",
          "path",
          "line",
          "source_sha256",
          "flow",
          "impact",
          "reproduction",
          "state",
          "owner_issue",
          "evidence",
          "resolution",
          "reuse"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "enum": [
              "CS-001",
              "CS-002",
              "CS-003",
              "CS-004",
              "CS-005",
              "CS-006",
              "CS-007",
              "CS-008",
              "CS-009",
              "CS-010",
              "CS-011",
              "CS-012",
              "CS-013",
              "CS-014",
              "CS-015",
              "CS-016",
              "CS-017",
              "CS-018",
              "CS-019",
              "CS-020",
              "CS-021",
              "CS-022",
              "CS-023",
              "CS-024",
              "CS-025",
              "CS-026",
              "CS-027",
              "CS-028",
              "CS-029",
              "CS-030"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "flow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "transformation",
              "sink"
            ],
            "properties": {
              "input": {
                "type": "string",
                "minLength": 1
              },
              "transformation": {
                "type": "string",
                "minLength": 1
              },
              "sink": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "unreviewed",
              "needs-review",
              "confirmed-violation",
              "false-positive",
              "fixed",
              "justified-exception",
              "out-of-scope",
              "reviewed"
            ]
          },
          "owner_issue": {
            "type": "integer",
            "enum": [
              686,
              687,
              688,
              689,
              690,
              691,
              692
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "reuse": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "intent",
                  "public_contract",
                  "stability_evidence",
                  "consumer_requirements",
                  "divergence_counterexample",
                  "decision",
                  "reason",
                  "verification"
                ],
                "properties": {
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "public_contract": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stability_evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "consumer_requirements": {
                    "type": "string",
                    "minLength": 1
                  },
                  "divergence_counterexample": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "fixed",
                    "false-positive",
                    "justified-exception",
                    "out-of-scope",
                    "reviewed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "fixed",
                    "false-positive",
                    "justified-exception",
                    "out-of-scope"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "resolution": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "rule_id": {
                  "enum": [
                    "CS-013",
                    "CS-014"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reuse": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    }
  }
}
