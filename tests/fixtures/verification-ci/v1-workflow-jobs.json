{
  "source": {
    "revision": "e2110862fef5af5a2c4c9a1d25f2e0ec429791c4",
    "path": ".github/workflows/test.yml",
    "sha256": "885fdc2cc5e91661d7b15a0fced7e5fb782f9d354a6209e9fbc7e5b8accefa38",
    "note": "Last shipped v1 planner and A9 advisory jobs; v2 (220f60af) removed them from the live workflow."
  },
  "jobs": {
    "ci-plan": {
      "name": "ci-plan",
      "runs-on": "ubuntu-latest",
      "permissions": {
        "contents": "read"
      },
      "outputs": {
        "run_a9_advisory": "${{ steps.plan.outputs.run_a9_advisory }}",
        "run_a9_advisory_inputs": "${{ steps.plan.outputs.run_a9_advisory_inputs }}",
        "run_ci_mcp_tests": "${{ steps.plan.outputs.run_ci_mcp_tests }}",
        "run_ci_plan": "${{ steps.plan.outputs.run_ci_plan }}",
        "run_cli_hook_enforcement": "${{ steps.plan.outputs.run_cli_hook_enforcement }}",
        "run_cloud_native": "${{ steps.plan.outputs.run_cloud_native }}",
        "run_coding_standards": "${{ steps.plan.outputs.run_coding_standards }}",
        "run_installers": "${{ steps.plan.outputs.run_installers }}",
        "run_interrupted_recovery": "${{ steps.plan.outputs.run_interrupted_recovery }}",
        "run_local_env_mcp_tests": "${{ steps.plan.outputs.run_local_env_mcp_tests }}",
        "run_loops_routing": "${{ steps.plan.outputs.run_loops_routing }}",
        "run_mcp_tests": "${{ steps.plan.outputs.run_mcp_tests }}",
        "run_posix_regression": "${{ steps.plan.outputs.run_posix_regression }}",
        "run_posix_unwired_sharded": "${{ steps.plan.outputs.run_posix_unwired_sharded }}",
        "run_sql_contract": "${{ steps.plan.outputs.run_sql_contract }}",
        "run_sql_postgres": "${{ steps.plan.outputs.run_sql_postgres }}",
        "run_sql_mysql": "${{ steps.plan.outputs.run_sql_mysql }}",
        "run_sql_tsql": "${{ steps.plan.outputs.run_sql_tsql }}",
        "run_test": "${{ steps.plan.outputs.run_test }}",
        "run_test_windows_heavy": "${{ steps.plan.outputs.run_test_windows_heavy }}",
        "run_version_gates": "${{ steps.plan.outputs.run_version_gates }}",
        "run_version_gates_windows_bump": "${{ steps.plan.outputs.run_version_gates_windows_bump }}",
        "run_version_gates_windows_lanes": "${{ steps.plan.outputs.run_version_gates_windows_lanes }}",
        "run_windows_powershell": "${{ steps.plan.outputs.run_windows_powershell }}",
        "plan_artifact_name": "${{ steps.plan.outputs.plan_artifact_name }}"
      },
      "steps": [
        {
          "name": "Set up Node.js 26",
          "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
          "with": {
            "node-version": "26.13.0"
          }
        },
        {
          "name": "Checkout tested plan inputs",
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "ref": "${{ github.sha }}",
            "path": "subject",
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "name": "Checkout trusted base planner",
          "if": "github.event_name == 'pull_request'",
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "ref": "${{ github.event.pull_request.base.sha }}",
            "path": "trusted",
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "name": "Install pinned structural parser dependencies",
          "shell": "bash",
          "run": "set -euo pipefail\nnpm ci --prefix subject/mcp/sdd-forge-mcp --ignore-scripts\nif [[ -f trusted/mcp/sdd-forge-mcp/package-lock.json ]]; then\n  npm ci --prefix trusted/mcp/sdd-forge-mcp --ignore-scripts\nfi",
          "env": {
            "npm_config_fetch_retries": "2",
            "npm_config_loglevel": "http"
          }
        },
        {
          "name": "Generate revision-bound plan",
          "id": "plan",
          "shell": "bash",
          "env": {
            "CI_EVENT": "${{ github.event_name }}",
            "CI_BASE_SHA": "${{ github.event.pull_request.base.sha }}",
            "CI_HEAD_SHA": "${{ github.event.pull_request.head.sha }}",
            "CI_TESTED_SHA": "${{ github.sha }}",
            "CI_API_HEAD_SHA": "${{ github.event.pull_request.head.sha || github.sha }}",
            "CI_FORCE_FULL": "${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.id != github.repository_id && 'true' || vars.SDD_CI_FORCE_FULL }}"
          },
          "run": "set -euo pipefail\nsubject=\"$GITHUB_WORKSPACE/subject\"\ntrusted=\"$GITHUB_WORKSPACE/trusted\"\nplanner=\"$subject/tests/verification-impact.py\"\nif [[ \"$CI_EVENT\" == pull_request && -f \"$trusted/tests/verification-impact.py\" ]] &&\n  grep -Fq 'verification-ci-plan/v1' \"$trusted/tests/verification-impact.py\" &&\n  grep -Fq 'def plan_main(' \"$trusted/tests/verification-impact.py\"; then\n  planner=\"$trusted/tests/verification-impact.py\"\nfi\nif [[ \"$CI_EVENT\" != pull_request ]]; then\n  trusted=\"$subject\"\nfi\nmkdir -p \"$RUNNER_TEMP/verification-plan\"\npython3 -I -B \"$planner\" --plan --root \"$subject\" --trusted-root \"$trusted\" --event \"$CI_EVENT\" --run-id \"$GITHUB_RUN_ID\" --run-attempt \"$GITHUB_RUN_ATTEMPT\" --api-head-sha \"$CI_API_HEAD_SHA\" --tested-revision \"$CI_TESTED_SHA\" --base \"$CI_BASE_SHA\" --head \"$CI_HEAD_SHA\" --force-full \"$CI_FORCE_FULL\" --output \"$RUNNER_TEMP/verification-plan/plan.json\" --github-output \"$GITHUB_OUTPUT\"\nprintf 'plan_artifact_name=verification-plan-%s-%s\\n' \"$GITHUB_RUN_ID\" \"$GITHUB_RUN_ATTEMPT\" >> \"$GITHUB_OUTPUT\"\n"
        },
        {
          "name": "Upload original planning-attempt artifact",
          "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
          "with": {
            "name": "${{ steps.plan.outputs.plan_artifact_name }}",
            "path": "${{ runner.temp }}/verification-plan/plan.json",
            "if-no-files-found": "error"
          }
        }
      ]
    },
    "a9-advisory-inputs": {
      "name": "A9 advisory activation detection",
      "runs-on": "ubuntu-latest",
      "permissions": {
        "contents": "read"
      },
      "outputs": {
        "active": "${{ steps.detect.outputs.active }}"
      },
      "steps": [
        {
          "name": "Read trusted base",
          "if": "github.event_name == 'pull_request'",
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "ref": "${{ github.event.pull_request.base.sha }}",
            "path": "trusted",
            "persist-credentials": false
          }
        },
        {
          "name": "Read exact PR head",
          "if": "github.event_name == 'pull_request'",
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "repository": "${{ github.event.pull_request.head.repo.full_name }}",
            "ref": "${{ github.event.pull_request.head.sha }}",
            "path": "subject",
            "persist-credentials": false
          }
        },
        {
          "name": "Detect advisory activation without executing repository code",
          "id": "detect",
          "shell": "bash",
          "env": {
            "A9_EVENT_NAME": "${{ github.event_name }}"
          },
          "run": "python3 - <<'PYCODE'\nimport json, os\nactive = os.environ['A9_EVENT_NAME'] == 'pull_request' and any(\n    os.path.lexists(root + '/sdd/project-context.yaml') for root in ('trusted', 'subject'))\nwith open(os.environ['GITHUB_OUTPUT'], 'a', encoding='utf-8') as output:\n    output.write('active=' + str(active).lower() + '\\n')\nprint(json.dumps({'state': 'inputs_required' if active else 'not_activated',\n                  'advisory_observed': False}))\nPYCODE\n"
        }
      ]
    },
    "a9-advisory": {
      "name": "capability-mode Gate",
      "needs": [
        "a9-advisory-inputs"
      ],
      "if": "needs.a9-advisory-inputs.outputs.active == 'true'",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 10,
      "permissions": {
        "contents": "read"
      },
      "steps": [
        {
          "name": "Checkout trusted collection implementation",
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "ref": "${{ github.event.pull_request.base.sha }}",
            "path": "trusted",
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "name": "Checkout isolated exact PR head as data",
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "repository": "${{ github.event.pull_request.head.repo.full_name }}",
            "ref": "${{ github.event.pull_request.head.sha }}",
            "path": "subject",
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "name": "Collect actual advisory consumers with explicit request",
          "shell": "bash",
          "env": {
            "A9_BASE_SHA": "${{ github.event.pull_request.base.sha }}",
            "A9_HEAD_SHA": "${{ github.event.pull_request.head.sha }}"
          },
          "run": "set -euo pipefail\numask 077\nif [ ! -f trusted/scripts/observe-a9-advisory.py ]; then\n  echo '{\"state\":\"blocked\",\"result\":\"BLOCKED\",\"authorization_checked\":false,\"missing_inputs\":[\"trusted_collector\"]}'\n  exit 1\nfi\nif ! git -C subject fetch --no-tags ../trusted \"$A9_BASE_SHA\" >/dev/null 2>&1; then\n  echo '{\"state\":\"blocked\",\"result\":\"BLOCKED\",\"authorization_checked\":false,\"missing_inputs\":[\"base_revision\"]}'\n  exit 1\nfi\nprivate_dir=$(mktemp -d \"$RUNNER_TEMP/a9-observation.XXXXXX\")\npython3 trusted/scripts/observe-a9-advisory.py \\\n  --repo-root \"$GITHUB_WORKSPACE/subject\" \\\n  --base-sha \"$A9_BASE_SHA\" --head-sha \"$A9_HEAD_SHA\" \\\n  --request sdd/a9-advisory-request.json \\\n  --output \"$private_dir/observation.json\"\n# Raw evidence stays private and is deliberately never uploaded.\n# A safe summary/check success alone cannot complete release evidence.\n"
        }
      ]
    }
  }
}
